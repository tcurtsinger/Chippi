<!-- Screen recording (docs/phase-7/screen-recording.md): the module, its shortcuts and starters on the capture layer's
     record mode, the recording's start, pause, stop and review, the red frame and the pill, over Chippi.Media's recorder.
     Its screens (the start bar, the pill's face, the recording card and page, Settings) are Lumen's, in Views. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Chippi.Features.Recording</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Chippi.Core\Chippi.Core.csproj" />
    <ProjectReference Include="..\..\Chippi.UI\Chippi.UI.csproj" />
    <ProjectReference Include="..\..\Chippi.Capture\Chippi.Capture.csproj" />
    <ProjectReference Include="..\..\Chippi.Media\Chippi.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chippi.Features.Recording.Tests" />
  </ItemGroup>

</Project>
