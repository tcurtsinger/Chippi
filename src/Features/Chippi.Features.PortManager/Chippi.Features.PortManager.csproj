<!-- Port manager (Phase 7, wave 3): who holds a network port, and freeing it. The engine reads the IP Helper tables as a
     standard user; ending a process or stopping a service that isn't the owner's goes through the admin helper. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Chippi.Features.PortManager</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Chippi.Core/Chippi.Core.csproj" />
    <ProjectReference Include="../../Chippi.UI/Chippi.UI.csproj" />
    <InternalsVisibleTo Include="Chippi.Features.PortManager.Tests" />
    <InternalsVisibleTo Include="Chippi.Island.Tests" />
  </ItemGroup>
</Project>
