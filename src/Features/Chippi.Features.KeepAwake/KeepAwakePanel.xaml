<!-- The Keep awake flyout panel (DESIGN.md §5 "Keep awake panel"): the status row and its switch,
     the duration chips, Keep screen on and More options, in one flyout card. -->
<UserControl x:Class="Chippi.Features.KeepAwake.KeepAwakePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="urn:chippi-ui">
 <StackPanel>
  <TextBlock Text="Keep awake" Style="{DynamicResource HeadlineTextStyle}" FontSize="13" Margin="0,0,0,8" />
  <c:Card Style="{DynamicResource FlyoutCardStyle}">
   <StackPanel>
    <Grid Margin="16,12">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
     </Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="Status" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="Detail" Style="{DynamicResource CaptionTextStyle}" TextWrapping="Wrap" />
     </StackPanel>
     <ToggleButton x:Name="Switch" Grid.Column="1" Style="{DynamicResource SwitchStyle}" VerticalAlignment="Center"
                   AutomationProperties.Name="Keep awake" />
    </Grid>
    <!-- 3 columns with 8px gaps: each chip carries 8px right and below, the grid takes the right back. -->
    <UniformGrid x:Name="Chips" Columns="3" Margin="12,0,4,4" />
   </StackPanel>
   <Grid Margin="16,0" MinHeight="48">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*" />
     <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Text="Keep screen on" VerticalAlignment="Center" />
    <ToggleButton x:Name="Screen" Grid.Column="1" Style="{DynamicResource SwitchStyle}" VerticalAlignment="Center"
                  AutomationProperties.Name="Keep screen on" />
   </Grid>
   <Button Style="{DynamicResource FlyoutRowButtonStyle}" Click="OnMoreOptions" AutomationProperties.Name="More options">
    <DockPanel>
     <c:LucideIcon DockPanel.Dock="Right" Data="{x:Static c:LucideIcons.ChevronRight}" Size="16" Brush="{DynamicResource TextSecondaryBrush}" />
     <TextBlock Text="More options" VerticalAlignment="Center" />
    </DockPanel>
   </Button>
  </c:Card>

  <!-- "Until…": pick a time, then Start. -->
  <Popup x:Name="UntilPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" PopupAnimation="None">
   <Border Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1"
           CornerRadius="8" Padding="12" Margin="0,4,0,0">
    <StackPanel Orientation="Horizontal">
     <ComboBox x:Name="UntilTime" Style="{DynamicResource HopperComboBoxStyle}" Width="140" AutomationProperties.Name="End time" />
     <Button Content="Start" Style="{DynamicResource PrimaryButtonStyle}" Margin="8,0,0,0" Click="OnStartUntil" />
    </StackPanel>
   </Border>
  </Popup>
 </StackPanel>
</UserControl>
