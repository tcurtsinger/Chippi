<!-- Keep awake, the Phase 1 reference module. Empty until WS4 lands. It references Chippi.UI (not
     Chippi.App) so its settings page and tile can use the themed controls. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Chippi.Features.KeepAwake</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Chippi.Core\Chippi.Core.csproj" />
    <ProjectReference Include="..\..\Chippi.UI\Chippi.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chippi.Features.KeepAwake.Tests" />
  </ItemGroup>

  <!-- P/Invoke via CsWin32. Each workstream lists its APIs in a NativeMethods.txt inside its own
       folder (Tray/, Island/, ...); every one of them is picked up, so no file is shared. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <AdditionalFiles Include="**\NativeMethods.txt" />
  </ItemGroup>

</Project>

