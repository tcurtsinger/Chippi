<!-- Quick actions (Phase 5.5): Windows settings and system actions in one click from the island. The Windows
     target version is for the radios (Windows.Devices.Radios). It references Sound for the shortcut type, as
     Paste as plain text does. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Chippi.Features.QuickActions</RootNamespace>
    <!-- AnyCPU like the other features, so the app's publish profile (which sets its RID inside the app, not for its
         references) can use it on either CPU. CsWin32 can't generate APPBARDATA and SHQUERYRBINFO for AnyCPU, so it
         generates them as on x64, whose layouts ARM64 shares; Chippi ships no x86. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Chippi.Core\Chippi.Core.csproj" />
    <ProjectReference Include="..\..\Chippi.UI\Chippi.UI.csproj" />
    <ProjectReference Include="..\Chippi.Features.Sound\Chippi.Features.Sound.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chippi.Features.QuickActions.Tests" />
  </ItemGroup>

  <!-- P/Invoke via CsWin32, from the NativeMethods.txt in this folder. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <AdditionalFiles Include="**\NativeMethods.txt" />
  </ItemGroup>

</Project>
