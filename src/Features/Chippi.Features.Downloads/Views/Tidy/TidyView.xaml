<!-- File organizer's island page (DESIGN.md §5 Island): the folder card with its picker and mode
     segment, actions for this folder, recent moves, and an in-widget detail for one held file. -->
<UserControl x:Class="Chippi.Features.Downloads.Views.Tidy.TidyView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="urn:chippi-ui"
 Foreground="{DynamicResource IslandTextBrush}" FontSize="12" AutomationProperties.Name="File organizer" Loaded="OnLoaded" Unloaded="OnUnloaded">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible" />
  <!-- The folder name as a picker: name and a small chevron, opening a flyout-colored list. -->
  <Style x:Key="FolderPickerStyle" TargetType="ComboBox" BasedOn="{StaticResource HopperComboBoxStyle}">
   <Setter Property="Height" Value="22"/>
   <Setter Property="HorizontalAlignment" Value="Left"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ComboBox">
     <Grid>
      <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="2,0">
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextTrimming="CharacterEllipsis" MaxWidth="180" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <c:LucideIcon Data="{x:Static c:LucideIcons.ChevronDown}" Size="12" Thickness="2" Margin="6,0,0,0" VerticalAlignment="Center" Brush="{DynamicResource TextSecondaryBrush}"/>
         </StackPanel>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></ControlTemplate.Triggers>
       </ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
       <Border Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0" MinWidth="232">
        <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
       </Border>
      </Popup>
     </Grid>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="OrganizerRowTemplate">
   <Grid x:Name="Row" Height="36" Margin="10,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <c:LucideIcon x:Name="Lead" Data="{Binding Lead}" Size="16" Brush="{DynamicResource IslandTextTertiaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
    <DockPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock x:Name="Detail" DockPanel.Dock="Right" MaxWidth="180" Margin="8,0,0,0" Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource IslandTextTertiaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
     <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
    </DockPanel>
    <Button x:Name="RowAction" Grid.Column="2" Content="{Binding ActionLabel}" Style="{DynamicResource IslandButtonStyle}" Width="72" Height="28" Margin="8,0,0,0" VerticalAlignment="Center"
            Visibility="{Binding HasTextAction, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding AccessibleAction}" Click="OnRowAction"/>
    <c:IconButton x:Name="RowIconAction" Height="24" Width="28" Grid.Column="2" Icon="{Binding ActionIcon}" Margin="8,0,0,0" Visibility="{Binding HasIconAction, Converter={StaticResource Visible}}"
                  ToolTip="{Binding ActionLabel}" AutomationProperties.Name="{Binding AccessibleAction}" Click="OnRowAction"/>
   </Grid>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding IsHistory}" Value="True"><Setter TargetName="Row" Property="Height" Value="30"/></DataTrigger>
    <DataTrigger Binding="{Binding Detail}" Value=""><Setter TargetName="Detail" Property="Visibility" Value="Collapsed"/></DataTrigger>
    <DataTrigger Binding="{Binding IsHeld}" Value="True"><Setter TargetName="Lead" Property="Brush" Value="{DynamicResource WarningBrush}"/><Setter TargetName="RowAction" Property="AutomationProperties.ItemStatus" Value="Held"/></DataTrigger>
    <DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter TargetName="Lead" Property="Brush" Value="{DynamicResource WarningBrush}"/><Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource WarningTextBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter TargetName="Lead" Property="Brush" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding NeedsLook}" Value="True"><Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource WarningTextBrush}"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
 </UserControl.Resources>
 <Grid>
 <Grid x:Name="ListPage">
 <DockPanel>
  <Border x:Name="FolderCard" DockPanel.Dock="Top" Style="{DynamicResource IslandCardStyle}" Height="44" Padding="10,0">
   <DockPanel>
    <c:SegmentedControl x:Name="Modes" DockPanel.Dock="Right" HorizontalContentAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource IslandSegmentedStyle}" SelectionChanged="OnModeChanged" AutomationProperties.Name="Folder mode">
     <c:SegmentItem Label="Auto"/><c:SegmentItem Label="Manual"/><c:SegmentItem Label="Paused"/>
    </c:SegmentedControl>
    <!-- A folder that's gone: its state in the mode's place. -->
    <TextBlock x:Name="NotFound" DockPanel.Dock="Right" Text="Not found" Visibility="Collapsed" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource WarningTextBrush}"/>
    <c:LucideIcon x:Name="FolderChip" Data="{x:Static c:LucideIcons.Folder}" Size="16" Brush="{DynamicResource IslandAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
    <ComboBox x:Name="Folders" MaxWidth="200" Style="{StaticResource FolderPickerStyle}" SelectionChanged="OnFolderChanged" AutomationProperties.Name="Watched folder">
     <ComboBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Path}" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Mode}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="16,0,0,0"/></Grid></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
   </DockPanel>
  </Border>


  <!-- The right edge matches the actions inside Recent: its 1-DIP border and 10-DIP inset. -->
  <DockPanel DockPanel.Dock="Bottom" Height="28" x:Name="Actions" Margin="0,8,11,0" LastChildFill="False">
   <Button x:Name="Organize" DockPanel.Dock="Right" Content="Organize" Width="72" Height="28" Style="{DynamicResource IslandAccentButtonStyle}" Click="OnOrganize" AutomationProperties.Name="Organize"/>
   <Button Style="{StaticResource SubtleButtonStyle}" Padding="10,0" Click="OnHistory" AutomationProperties.Name="History">
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="History" VerticalAlignment="Center"/>
     <c:LucideIcon Data="{x:Static c:LucideIcons.ChevronRight}" Size="12" Thickness="2" Margin="4,0,0,0" VerticalAlignment="Center" Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </StackPanel>
   </Button>
  </DockPanel>
  <TextBlock DockPanel.Dock="Bottom" x:Name="Error" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  <Border x:Name="Recent" Style="{DynamicResource IslandCardStyle}" Padding="0" Margin="0,8,0,0">
   <Grid>
    <!-- The picked folder is gone: point it somewhere else, or stop watching it. -->
    <StackPanel x:Name="Missing" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
     <c:LucideIcon Data="{x:Static c:LucideIcons.Folder}" Size="20" Brush="{DynamicResource WarningBrush}" HorizontalAlignment="Center"/>
     <TextBlock x:Name="MissingText" FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400" Margin="0,6,0,0"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
      <Button Content="Choose folder…" Style="{DynamicResource IslandButtonStyle}" Click="OnRelocate" AutomationProperties.Name="Choose another folder"/>
      <Button Content="Remove" Style="{DynamicResource IslandButtonStyle}" Margin="8,0,0,0" Click="OnRemove" AutomationProperties.Name="Stop watching this folder"/>
     </StackPanel>
    </StackPanel>
    <StackPanel x:Name="NoRecent" VerticalAlignment="Center" HorizontalAlignment="Center">
     <c:LucideIcon Data="{x:Static c:LucideIcons.File}" Size="20" Brush="{DynamicResource IslandTextTertiaryBrush}" HorizontalAlignment="Center"/>
     <TextBlock Text="No recent files" FontSize="12" Foreground="{DynamicResource IslandTextTertiaryBrush}" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Top">
     <ItemsControl x:Name="Rows" Focusable="False" ItemTemplate="{StaticResource OrganizerRowTemplate}"/>
     <Border x:Name="RecentHeading" Visibility="Collapsed" Height="24" BorderBrush="{DynamicResource IslandHairBrush}" BorderThickness="0,1,0,0" Margin="10,0">
      <TextBlock Text="Recent" FontSize="11" Foreground="{DynamicResource IslandTextTertiaryBrush}" VerticalAlignment="Center"/>
     </Border>
     <ItemsControl x:Name="HistoryRows" Focusable="False" ItemTemplate="{StaticResource OrganizerRowTemplate}"/>
    </StackPanel>
   </Grid>
  </Border>


 </DockPanel>
  <StackPanel x:Name="Empty" Visibility="Collapsed" VerticalAlignment="Center">
   <c:LucideIcon Data="{x:Static c:LucideIcons.Folder}" Size="20" Brush="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
   <TextBlock Text="No folders yet" HorizontalAlignment="Center" Margin="0,12,0,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
    <Button Content="Add Downloads" Style="{DynamicResource IslandAccentButtonStyle}" Click="OnAddDownloads" AutomationProperties.Name="Add Downloads"/>
    <Button Content="Choose folder…" Style="{DynamicResource IslandButtonStyle}" Margin="8,0,0,0" Click="OnChooseFolder" AutomationProperties.Name="Choose folder"/>
   </StackPanel>
  </StackPanel>
 </Grid>
 <Grid x:Name="InspectPage" Visibility="Collapsed" Focusable="True" AutomationProperties.Name="File details">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{DynamicResource IslandCardStyle}" Padding="15,16">
   <StackPanel>
    <StackPanel Orientation="Horizontal">
     <c:LucideIcon x:Name="InspectGlyph" Data="{x:Static c:LucideIcons.TriangleAlert}" Size="16" Margin="0,0,8,0" Brush="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
     <TextBlock x:Name="InspectStatus" Text="Held" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    <TextBlock x:Name="InspectName" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="74" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <TextBlock x:Name="InspectReason" Visibility="Collapsed" Foreground="{DynamicResource IslandTextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <Border BorderBrush="{DynamicResource IslandHairBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
     <DockPanel>
      <c:LucideIcon Data="{x:Static c:LucideIcons.Folder}" DockPanel.Dock="Left" Size="16" Brush="{DynamicResource IslandTextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="InspectFolder" Foreground="{DynamicResource IslandTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
    </Border>
   </StackPanel>
  </Border>
  <TextBlock x:Name="InspectError" Grid.Row="1" Visibility="Collapsed" Margin="10,8,10,0" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  <Button x:Name="ShowFile" Grid.Row="2" Content="Show in folder" AutomationProperties.Name="Show in folder" Style="{DynamicResource IslandButtonStyle}" HorizontalAlignment="Right" Margin="0,8,11,0" Click="OnShowFile"/>
 </Grid>
 </Grid>
</UserControl>
