<UserControl x:Class="Chippi.Features.Downloads.Views.Tidy.TidyView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="urn:chippi-ui"
 AutomationProperties.Name="Tidy" Loaded="OnLoaded" Unloaded="OnUnloaded">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible" />
  <SolidColorBrush x:Key="TidyWarningTextBrush" Color="#F5A64B" />
  <Style x:Key="ModeItem" TargetType="ListBoxItem" BasedOn="{StaticResource SegmentItemStyle}">
   <Setter Property="Height" Value="28"/><Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="FolderPickerStyle" TargetType="ComboBox" BasedOn="{StaticResource HopperComboBoxStyle}">
   <Setter Property="Height" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ComboBox">
     <Grid>
      <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6"><c:LucideIcon Data="{x:Static c:LucideIcons.ChevronDown}" Size="12" HorizontalAlignment="Right" Margin="0,0,2,0" Brush="{DynamicResource TextTertiaryBrush}"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></ControlTemplate.Triggers>
       </ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <TextBlock Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis" Margin="0,0,20,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextPrimaryBrush}"/>
      <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
       <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="11" Padding="4" Margin="0,4,0,0" MinWidth="232">
        <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
       </Border>
      </Popup>
     </Grid>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <StackPanel>
  <Border x:Name="FolderCard" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="13">
   <StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="FolderChip" Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentGradientBrush}" VerticalAlignment="Center"><c:LucideIcon Data="{x:Static c:LucideIcons.Folder}" Size="17" Brush="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel Grid.Column="1" Margin="11,0,0,0">
      <ComboBox x:Name="Folders" Style="{StaticResource FolderPickerStyle}" SelectionChanged="OnFolderChanged" AutomationProperties.Name="Watched folder">
       <ComboBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Path}" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Mode}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="16,0,0,0"/></Grid></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock x:Name="ModeLine" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </Grid>
    <c:SegmentedControl x:Name="Modes" Height="34" Margin="0,12,0,0" ItemContainerStyle="{StaticResource ModeItem}" SelectionChanged="OnModeChanged" AutomationProperties.Name="Folder mode">
     <c:SegmentItem Label="Silent"/><c:SegmentItem Label="Manual"/><c:SegmentItem Label="Paused"/>
    </c:SegmentedControl>
   </StackPanel>
  </Border>
  <StackPanel x:Name="Empty" Visibility="Collapsed" Margin="0,30,0,20">
   <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource ChipBrush}" HorizontalAlignment="Center"><c:LucideIcon Data="{x:Static c:LucideIcons.Folder}" Size="20" Brush="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <TextBlock Text="No folders yet" Style="{StaticResource TitleTextStyle}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
   <TextBlock Text="New folders start in Manual" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
    <Button Content="Add Downloads" Style="{StaticResource PrimaryButtonStyle}" Click="OnAddDownloads" AutomationProperties.Name="Add Downloads"/>
    <Button Content="Choose folder…" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="OnChooseFolder" AutomationProperties.Name="Choose folder"/>
   </StackPanel>
  </StackPanel>
  <StackPanel x:Name="Recent" Margin="0,12,0,0">
   <TextBlock Text="RECENTLY STASHED" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8"/>
   <TextBlock x:Name="NoRecent" Text="Nothing stashed yet" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,12"/>
   <ItemsControl x:Name="Rows">
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border x:Name="Row" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="Transparent" Padding="11,8,8,8" Margin="0,0,0,6">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
        <TextBlock x:Name="Detail" Text="{Binding Detail}" Style="{StaticResource CaptionTextStyle}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
       </StackPanel>
       <TextBlock Grid.Column="1" Text="{Binding Age}" Style="{StaticResource MonoTextStyle}" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="8,0,6,0"/>
       <c:IconButton x:Name="Action" Grid.Column="2" Icon="{Binding ActionIcon}" Visibility="{Binding HasAction, Converter={StaticResource Visible}}" ToolTip="{Binding ActionLabel}" AutomationProperties.Name="{Binding AccessibleAction}" Click="OnRowAction"/>
       <c:LucideIcon x:Name="Waiting" Grid.Column="2" Data="{x:Static c:LucideIcons.Clock}" Size="15" Brush="{DynamicResource TextTertiaryBrush}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
     </Border>
     <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsHeld}" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource WarningBorder45Brush}"/><Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource TidyWarningTextBrush}"/></DataTrigger>
      <DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource TidyWarningTextBrush}"/></DataTrigger>
      <DataTrigger Binding="{Binding IsWaiting}" Value="True"><Setter TargetName="Waiting" Property="Visibility" Value="Visible"/></DataTrigger>
     </DataTemplate.Triggers>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </StackPanel>
  <Grid x:Name="Actions" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button Content="Organize now" Style="{StaticResource PrimaryButtonStyle}" Click="OnOrganize" AutomationProperties.Name="Organize now"/>
   <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="OnRules" AutomationProperties.Name="Rules"><StackPanel Orientation="Horizontal"><c:LucideIcon Data="{x:Static c:LucideIcons.Sliders}" Size="14" Brush="{DynamicResource ButtonTextBrush}" VerticalAlignment="Center"/><TextBlock Text="Rules" Margin="6,0,0,0"/></StackPanel></Button>
  </Grid>
  <TextBlock x:Name="Error" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource TidyWarningTextBrush}" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel>
</UserControl>
