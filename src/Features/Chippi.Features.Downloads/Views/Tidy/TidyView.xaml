<!-- File organizer's island page (DESIGN.md §5 Island): the folder card with its picker and mode
     segment, the latest 3 moves or files waiting, then History and Organize now. The page's header
     shows the status. -->
<UserControl x:Class="Chippi.Features.Downloads.Views.Tidy.TidyView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="urn:chippi-ui"
 AutomationProperties.Name="File organizer" Loaded="OnLoaded" Unloaded="OnUnloaded">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible" />
  <!-- The folder name as a picker: name and a small chevron, opening a flyout-colored list. -->
  <Style x:Key="FolderPickerStyle" TargetType="ComboBox" BasedOn="{StaticResource HopperComboBoxStyle}">
   <Setter Property="Height" Value="22"/>
   <Setter Property="HorizontalAlignment" Value="Left"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ComboBox">
     <Grid>
      <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="2,0">
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <c:LucideIcon Data="{x:Static c:LucideIcons.ChevronDown}" Size="12" Thickness="2" Margin="6,0,0,0" VerticalAlignment="Center" Brush="{DynamicResource TextSecondaryBrush}"/>
         </StackPanel>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></ControlTemplate.Triggers>
       </ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
       <Border Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0" MinWidth="232">
        <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
       </Border>
      </Popup>
     </Grid>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <StackPanel>
  <Border x:Name="FolderCard" Style="{DynamicResource IslandCardStyle}">
   <StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <c:IconChip x:Name="FolderChip" Icon="{x:Static c:LucideIcons.Folder}" IsOn="True" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
      <ComboBox x:Name="Folders" Style="{StaticResource FolderPickerStyle}" SelectionChanged="OnFolderChanged" AutomationProperties.Name="Watched folder">
       <ComboBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Path}" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Mode}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="16,0,0,0"/></Grid></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
     </StackPanel>
    </Grid>
    <c:SegmentedControl x:Name="Modes" Margin="0,12,0,0" Style="{StaticResource FlyoutSegmentedControlStyle}" SelectionChanged="OnModeChanged" AutomationProperties.Name="Folder mode">
     <c:SegmentItem Label="Silent"/><c:SegmentItem Label="Manual"/><c:SegmentItem Label="Paused"/>
    </c:SegmentedControl>
   </StackPanel>
  </Border>

  <StackPanel x:Name="Empty" Visibility="Collapsed" Margin="0,24,0,24">
   <c:LucideIcon Data="{x:Static c:LucideIcons.Folder}" Size="24" Brush="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
   <TextBlock Text="No folders yet" HorizontalAlignment="Center" Margin="0,12,0,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
    <Button Content="Add Downloads" Style="{StaticResource PrimaryButtonStyle}" Click="OnAddDownloads" AutomationProperties.Name="Add Downloads"/>
    <Button Content="Choose folder…" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="OnChooseFolder" AutomationProperties.Name="Choose folder"/>
   </StackPanel>
  </StackPanel>

  <Border x:Name="Recent" Style="{DynamicResource IslandCardStyle}" Padding="0" Margin="0,8,0,0">
   <StackPanel>
    <TextBlock x:Name="NoRecent" Text="Nothing moved yet" Style="{StaticResource CaptionTextStyle}" Margin="12"/>
    <ItemsControl x:Name="Rows" Focusable="False">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:Card Style="{StaticResource CardRowsStyle}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid MinHeight="36" Margin="12,8,8,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <c:LucideIcon x:Name="Lead" Data="{Binding Lead}" Size="16" Brush="{DynamicResource TextMutedBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
        <TextBlock x:Name="Detail" Text="{Binding Detail}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
       </StackPanel>
       <Button Grid.Column="2" Content="Review" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" VerticalAlignment="Center"
               Visibility="{Binding IsReview, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding AccessibleAction}" Click="OnRowAction"/>
       <c:IconButton Grid.Column="2" Icon="{Binding ActionIcon}" Margin="8,0,0,0" Visibility="{Binding HasIconAction, Converter={StaticResource Visible}}"
                     ToolTip="{Binding ActionLabel}" AutomationProperties.Name="{Binding AccessibleAction}" Click="OnRowAction"/>
      </Grid>
      <DataTemplate.Triggers>
       <DataTrigger Binding="{Binding IsHeld}" Value="True"><Setter TargetName="Lead" Property="Brush" Value="{DynamicResource WarningBrush}"/><Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource WarningTextBrush}"/></DataTrigger>
       <DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter TargetName="Lead" Property="Brush" Value="{DynamicResource WarningBrush}"/><Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource WarningTextBrush}"/></DataTrigger>
      </DataTemplate.Triggers>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </Border>

  <!-- History on the left, Organize now on the right. -->
  <DockPanel x:Name="Actions" Margin="0,8,0,0" LastChildFill="False">
   <Button DockPanel.Dock="Right" Content="Organize now" Style="{StaticResource SecondaryButtonStyle}" Click="OnOrganize" AutomationProperties.Name="Organize now"/>
   <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,0" Click="OnHistory" AutomationProperties.Name="History">
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="History" VerticalAlignment="Center"/>
     <c:LucideIcon Data="{x:Static c:LucideIcons.ChevronRight}" Size="12" Thickness="2" Margin="4,0,0,0" VerticalAlignment="Center" Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </StackPanel>
   </Button>
  </DockPanel>
  <TextBlock x:Name="Error" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel>
</UserControl>
