<!-- System monitor (Phase 4): CPU, memory, GPU, network, disks, battery and thermal zones, read as a
     standard user and shown on the island. Windows 10 SDK target for Windows.Devices.Power. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Chippi.Features.SystemMonitor</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Chippi.Core\Chippi.Core.csproj" />
    <ProjectReference Include="..\..\Chippi.UI\Chippi.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chippi.Features.SystemMonitor.Tests" />
  </ItemGroup>

</Project>
