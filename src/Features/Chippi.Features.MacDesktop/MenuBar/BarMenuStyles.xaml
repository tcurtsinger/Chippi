<!-- The Mac-style desktop's menus (docs/mac-style/brief.md, Menu bar): the island's flyout style, 8 corners, 30-DIP rows,
     13 text, shortcut hints right-aligned in tertiary. They follow the app theme (FlyoutBrush and the text brushes). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="BarContextMenuStyle" TargetType="{x:Type ContextMenu}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Margin="12,4,12,16" Padding="4" MinWidth="220" CornerRadius="8"
                            Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                            Effect="{DynamicResource WindowShadow}">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Separator}" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1" Margin="8,4,8,4" Background="{DynamicResource BorderStrongBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="Row" Height="30" CornerRadius="4" Background="Transparent" Padding="8,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Check" Visibility="Collapsed" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                                  HorizontalAlignment="Left" Data="M1,6 L4.5,9.5 L11,2.5" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="IconSlot" ContentSource="Icon" Width="16" Height="16" HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center"
                                              TextBlock.FontSize="13" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="28,0,0,0" FontSize="12"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <Path x:Name="Arrow" Grid.Column="3" Visibility="Collapsed" Width="6" Height="10" Margin="12,0,0,0" Stretch="Uniform"
                                  VerticalAlignment="Center" Data="M1,1 L5,5 L1,9" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource TextSecondaryBrush}" />
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-6" VerticalOffset="-9" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="None"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Margin="12,4,12,16" Padding="4" MinWidth="200" CornerRadius="8"
                                        Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                        Effect="{DynamicResource WindowShadow}" TextBlock.FontSize="13">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="IconSlot" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
