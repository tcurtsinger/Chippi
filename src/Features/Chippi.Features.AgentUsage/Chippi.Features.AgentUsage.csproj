<!-- AI agent usage (Phase 5.5): Claude Code's and Codex's limits and sessions, read from their own programs and files,
     on the island and in Settings. It references Chippi.UI for the island's and Settings' controls. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Chippi.Features.AgentUsage</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Chippi.Core\Chippi.Core.csproj" />
    <ProjectReference Include="..\..\Chippi.UI\Chippi.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chippi.Features.AgentUsage.Tests" />
    <!-- WPF leaves System.IO out of the implicit usings; the readers are all files. -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
