<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework><SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion><UseWPF>true</UseWPF>
    <MicrosoftManagementDeployment-FactoryLinkage>static</MicrosoftManagementDeployment-FactoryLinkage>
    <MicrosoftManagementDeployment-Platform Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier.Replace('win-', ''))</MicrosoftManagementDeployment-Platform>
    <MicrosoftManagementDeployment-Platform Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.Replace('win-', ''))</MicrosoftManagementDeployment-Platform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" GeneratePathProperty="true" />
    <ProjectReference Include="../../Chippi.Core/Chippi.Core.csproj" />
    <ProjectReference Include="../../Chippi.UI/Chippi.UI.csproj" />
    <InternalsVisibleTo Include="Chippi.Features.AppUpdates.Tests" />
    <InternalsVisibleTo Include="Chippi.Island.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The package copies its factory beside this library; Content also carries it through app/test project references. -->
    <Content Include="$(PkgMicrosoft_WindowsPackageManager_ComInterop)/bin/win-$(MicrosoftManagementDeployment-Platform)/native/static/Microsoft.Management.Deployment.dll" Link="Microsoft.Management.Deployment.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="$(PkgMicrosoft_WindowsPackageManager_ComInterop)/lib/uap10.0/Microsoft.Management.Deployment.winmd" Link="Microsoft.Management.Deployment.winmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="$(PkgMicrosoft_WindowsPackageManager_ComInterop)/NOTICE.txt" Link="licenses/WinGet-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
