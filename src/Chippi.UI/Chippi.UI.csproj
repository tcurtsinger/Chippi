<!-- Chippi's design system for WPF: theme dictionaries, type styles and templated controls (DESIGN.md
     §2-§6). The App and any feature with its own views reference this, never Chippi.App. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Chippi.UI</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chippi.Core\Chippi.Core.csproj" />
    <ProjectReference Include="..\Chippi.Capture\Chippi.Capture.csproj" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <AdditionalFiles Include="Displays\NativeMethods.txt" />
    <Resource Include="Pet\Assets\*.png" />
  </ItemGroup>

  <!-- Chippi's test hooks (ChippiPet's breathing, faces, a blink on demand) for the pet sheet and the tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Chippi" />
    <InternalsVisibleTo Include="Chippi.Island.Tests" />
    <InternalsVisibleTo Include="Chippi.Features.CommandBar.Tests" />
  </ItemGroup>

  <!-- The control gallery is a development tool: compiled into Debug builds only. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Page Remove="Controls\Gallery\**" />
    <Compile Remove="Controls\Gallery\**" />
  </ItemGroup>

</Project>
