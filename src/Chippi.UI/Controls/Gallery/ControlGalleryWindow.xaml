<!-- Debug-only control gallery (run Chippi.exe with &#45;&#45;gallery in a Debug build). Shows every token
     and control state for review against DESIGN.md. Hover and Tab through it to see hover and
     the focus rings; "Disable all" shows the .45 disabled state. -->
<Window x:Class="Chippi.UI.Controls.Gallery.ControlGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Chippi.UI.Controls"
        xmlns:m="clr-namespace:Chippi.Core.Modules;assembly=Chippi.Core"
        Title="Chippi control gallery (debug)" Width="1180" Height="900"
        Style="{StaticResource ChippiWindowStyle}"
        Background="{DynamicResource BackdropBrush}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Section" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Swatch" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="118" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource TitlebarBrush}" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Disable all" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextTertiaryBrush}" />
                    <ToggleButton x:Name="DisableAll" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Disable all controls" />
                </StackPanel>
                <c:SegmentedControl x:Name="ThemePicker" Width="300" HorizontalAlignment="Left" SelectionChanged="OnThemeChanged"
                                    AutomationProperties.Name="Theme">
                    <c:SegmentItem Label="Dark" />
                    <c:SegmentItem Label="Light" />
                    <c:SegmentItem Label="Follow Windows" />
                </c:SegmentedControl>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
            <StackPanel x:Name="Root" IsEnabled="{Binding IsChecked, ElementName=DisableAll, Converter={StaticResource InverseBool}}">
                <!-- Type -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <c:Eyebrow Text="Typography" Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource DisplayTextStyle}" Text="Display 17/800 · Features" />
                        <TextBlock Style="{StaticResource HeadlineTextStyle}" Text="Headline 15.5/700 · Chippi" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource TitleTextStyle}" Text="Title 13.5/600 · Keep awake" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource BodyTextStyle}" Text="Body 12.5/500 · Prevents sleep while you are away" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Caption 11.5/500 · Pinned · noise suppression on" Margin="0,6,0,0" />
                        <c:Eyebrow Text="Label 10.5/700 now playing to" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource MonoTextStyle}" Text="Mono 11.5/600 · 64% 12:04 1.2 MB/s" />
                            <TextBlock Style="{StaticResource MonoReadoutTextStyle}" Text="23%" Margin="18,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="FontReport" Style="{StaticResource MonoTextStyle}" Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Tokens -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <c:Eyebrow Text="Chassis, ink and accent tokens" Margin="0,0,0,10" />
                        <WrapPanel x:Name="Swatches" />
                    </StackPanel>
                </Border>

                <!-- Buttons -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <c:Eyebrow Text="Buttons" Margin="0,0,0,10" />
                        <WrapPanel>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Organize now" Margin="0,0,10,0" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Rules" Margin="0,0,10,0" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Disabled" IsEnabled="False" Margin="0,0,20,0" />
                            <c:IconButton Icon="{x:Static c:LucideIcons.Settings}" AutomationProperties.Name="Settings" Margin="0,0,6,0" />
                            <c:IconButton Icon="{x:Static c:LucideIcons.Undo}" ToolTip="Undo" Margin="0,0,6,0" />
                            <c:IconToggleButton Icon="{x:Static c:LucideIcons.Volume}" CheckedIcon="{x:Static c:LucideIcons.VolumeMuted}"
                                                AutomationProperties.Name="Mute" Margin="0,0,20,0" />
                            <Button Style="{StaticResource WindowButtonStyle}" AutomationProperties.Name="Minimize" Margin="0,0,4,0">
                                <c:LucideIcon Data="{x:Static c:LucideIcons.Minus}" Size="15"
                                              Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button Style="{StaticResource CloseButtonStyle}" AutomationProperties.Name="Close">
                                <c:LucideIcon Data="{x:Static c:LucideIcons.Close}" Size="15"
                                              Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Inputs -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <c:Eyebrow Text="Switch, segmented, slider, search, combo" Margin="0,0,0,10" />
                        <WrapPanel VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Off switch" Margin="0,0,12,0" />
                            <ToggleButton Style="{StaticResource SwitchStyle}" IsChecked="True" AutomationProperties.Name="On switch" Margin="0,0,12,0" />
                            <ToggleButton Style="{StaticResource SwitchStyle}" IsEnabled="False" AutomationProperties.Name="Disabled switch" Margin="0,0,12,0" />
                            <ToggleButton Style="{StaticResource SwitchStyle}" IsChecked="True" IsEnabled="False" AutomationProperties.Name="Disabled on switch" Margin="0,0,24,0" />
                            <Slider Style="{StaticResource HopperSliderStyle}" Width="220" Minimum="0" Maximum="100" Value="64"
                                    AutomationProperties.Name="Volume" VerticalAlignment="Center" Margin="0,0,24,0" />
                            <ComboBox Style="{StaticResource HopperComboBoxStyle}" Width="220" Tag="Pick a device..." AutomationProperties.Name="Device">
                                <ComboBoxItem Content="Speakers (Realtek)" />
                                <ComboBoxItem Content="Headphones (USB)" />
                            </ComboBox>
                        </WrapPanel>
                        <c:SegmentedControl Margin="0,16,0,0" Width="560" HorizontalAlignment="Left" SelectedIndex="0" AutomationProperties.Name="Preset">
                            <c:SegmentItem Label="Essentials" />
                            <c:SegmentItem Label="Audio" />
                            <c:SegmentItem Label="Power user" />
                            <c:SegmentItem Label="Everything" />
                            <c:SegmentItem Label="Custom" />
                        </c:SegmentedControl>
                        <c:SegmentedControl Style="{StaticResource TabSegmentedControlStyle}" Margin="0,12,0,0" Width="352" HorizontalAlignment="Left"
                                            SelectedIndex="3" AutomationProperties.Name="Flyout tabs">
                            <c:SegmentItem Label="Sound" Icon="{x:Static c:LucideIcons.Volume}" />
                            <c:SegmentItem Label="System" Icon="{x:Static c:LucideIcons.Cpu}" />
                            <c:SegmentItem Label="Tidy" Icon="{x:Static c:LucideIcons.Folder}" />
                            <c:SegmentItem Label="Tools" Icon="{x:Static c:LucideIcons.Wrench}" />
                        </c:SegmentedControl>
                        <c:SearchBox Margin="0,14,0,0" Width="320" HorizontalAlignment="Left" Placeholder="Search features" AutomationProperties.Name="Search features" />
                    </StackPanel>
                </Border>

                <!-- Badges and dots -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <c:Eyebrow Text="Badges and status dots" Margin="0,0,0,10" />
                        <WrapPanel VerticalAlignment="Center">
                            <c:Badge Kind="Source" Text="From Hopper" Margin="0,0,8,0" />
                            <c:Badge Kind="Overlap" Text="Overlaps PowerToys" Margin="0,0,8,0" />
                            <c:Badge Kind="Needs" Text="Needs VB-CABLE" Margin="0,0,24,0" />
                            <c:StatusDot Kind="Active" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Pinned · noise suppression on" Style="{StaticResource CaptionTextStyle}" Margin="0,0,18,0" VerticalAlignment="Center" />
                            <c:StatusDot Kind="Attention" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="2 files held" Style="{StaticResource CaptionTextStyle}" Margin="0,0,18,0" VerticalAlignment="Center" />
                            <c:StatusDot Kind="Offline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Offline" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Flyout parts at flyout width -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <c:Eyebrow Text="Rows and tiles (at flyout width, 352px inside 14px padding)" Margin="0,0,0,10" />
                        <WrapPanel>
                            <StackPanel Width="352" Margin="0,0,24,0">
                                <c:AppVolumeRow AppName="Spotify" DeviceName="Headphones (USB)" Volume="64" Margin="0,0,0,8" />
                                <c:AppVolumeRow AppName="Microsoft Teams" DeviceName="Speakers (Realtek)" Volume="30" IsMuted="True" Margin="0,0,0,8" />
                                <c:StashRow FileName="invoice-2026-10.pdf" Destination="Documents › Invoices" Age="2m" Margin="0,0,0,8" />
                                <c:StashRow FileName="AnyDesk.exe" IsHeld="True" HeldReason="Held · remote-access installer" Age="5m" />
                            </StackPanel>
                            <StackPanel Width="352">
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <c:StatTile x:Name="CpuTile" Label="CPU" Value="23%" Caption="3.4 GHz" Margin="0,0,4,4" />
                                    <c:StatTile x:Name="MemTile" Label="Memory" Value="61%" Caption="19.4 GB" Margin="4,0,0,4" />
                                </UniformGrid>
                                <UniformGrid Columns="3">
                                    <c:ToolTile Title="Keep awake" StateLine="Until 6:00 PM" Icon="{x:Static c:LucideIcons.Coffee}" IsChecked="True" Margin="0,0,4,0" />
                                    <c:ToolTile Title="Color picker" StateLine="Win+Shift+C" Icon="{x:Static c:LucideIcons.Droplet}" Margin="4,0,4,0" />
                                    <c:ToolTile Title="Disabled" StateLine="Off" Icon="{x:Static c:LucideIcons.Zap}" IsEnabled="False" Margin="4,0,0,0" />
                                </UniformGrid>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Feature cards -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <c:Eyebrow Text="Feature cards" Margin="0,0,0,10" />
                        <UniformGrid Columns="3">
                            <c:FeatureCard x:Name="KeepAwakeCard" FeatureName="Keep awake" Description="Stops the PC from sleeping, for a while or until you say"
                                           Icon="{x:Static c:LucideIcons.Coffee}" IsInstalled="True" Margin="0,0,6,0" />
                            <c:FeatureCard x:Name="RoutingCard" FeatureName="Audio routing" Description="Switches output by priority and pins your mic"
                                           Icon="{x:Static c:LucideIcons.Headphones}" Margin="6,0,6,0" />
                            <c:FeatureCard x:Name="ClipboardCard" FeatureName="Clipboard history" Description="Keeps what you copied, searchable"
                                           Icon="{x:Static c:LucideIcons.Clipboard}" IsComingSoon="True" Margin="6,0,0,0" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Phase 2 controls (provisional) -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <c:Eyebrow Text="Phase 2 controls (provisional)" Margin="0,0,0,10" />
                        <WrapPanel VerticalAlignment="Center">
                            <CheckBox Content="Unchecked" Margin="0,0,18,0" />
                            <CheckBox Content="Checked" IsChecked="True" Margin="0,0,18,0" />
                            <CheckBox Content="Mixed" IsChecked="{x:Null}" IsThreeState="True" Margin="0,0,18,0" />
                            <CheckBox Content="Disabled" IsEnabled="False" Margin="0,0,18,0" />
                            <CheckBox Content="Disabled checked" IsChecked="True" IsEnabled="False" Margin="0,0,18,0" />
                            <CheckBox AutomationProperties.Name="Select row" IsChecked="True" />
                        </WrapPanel>
                        <WrapPanel Margin="0,14,0,0">
                            <TextBox Style="{StaticResource TextFieldStyle}" Width="260" Tag="Destination, e.g. Documents\{year}" AutomationProperties.Name="Destination" Margin="0,0,14,0" />
                            <TextBox Style="{StaticResource TextFieldStyle}" Width="260" Text="Invoices\{year}\{month}" AutomationProperties.Name="Filled" Margin="0,0,14,0" />
                            <TextBox Style="{StaticResource TextFieldStyle}" Width="200" Text="Read only" IsReadOnly="True" AutomationProperties.Name="Read only" Margin="0,0,14,0" />
                            <TextBox Style="{StaticResource TextFieldStyle}" Width="200" Text="Disabled" IsEnabled="False" AutomationProperties.Name="Disabled field" />
                        </WrapPanel>
                        <WrapPanel Margin="0,14,0,0" VerticalAlignment="Center">
                            <c:DragHandle Margin="0,0,8,0" />
                            <TextBlock Text="PDFs to Documents" VerticalAlignment="Center" Margin="0,0,24,0" />
                            <c:DragHandle IsEnabled="False" Margin="0,0,8,0" />
                            <TextBlock Text="Disabled" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <!-- Island tokens -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <c:Eyebrow Text="Island and pet tokens (theme-invariant)" Margin="0,0,0,10" />
                        <Border Background="{DynamicResource IslandBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1"
                                CornerRadius="19" Height="38" Width="292" HorizontalAlignment="Left" Padding="14,0" Effect="{DynamicResource IslandShadow}">
                            <TextBlock VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource IslandTextBrush}">
                                <Run Text="Weekend Mix" /><Run Text="  ·  Spotify" Foreground="{DynamicResource IslandTextTertiaryBrush}" FontWeight="Medium" />
                            </TextBlock>
                        </Border>
                        <WrapPanel x:Name="PetSwatches" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
