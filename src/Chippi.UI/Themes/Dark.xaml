<!-- Dark theme (the default). Ported from Hopper's Ui/Themes/Dark.xaml; key names are unchanged
     so Hopper's views move over as-is. Theme-invariant tokens (deep gradient, island, pet,
     badge tints, glows) live in Palette.xaml. Values: DESIGN.md §2 and §4. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackdropColor">#0A0D18</Color>
    <Color x:Key="WindowBackgroundColor">#0B0F1F</Color>
    <Color x:Key="TitlebarColor">#0D1224</Color>
    <Color x:Key="PanelColor">#0F1426</Color>
    <Color x:Key="SurfaceColor">#131930</Color>
    <Color x:Key="SurfaceSelectedColor">#1A2240</Color>
    <Color x:Key="ChipColor">#1B2240</Color>
    <Color x:Key="InputColor">#11172C</Color>
    <Color x:Key="TrackColor">#161D38</Color>
    <Color x:Key="TrackRemainderColor">#22294A</Color>
    <Color x:Key="SwitchOffColor">#262E4A</Color>
    <Color x:Key="ButtonBackgroundColor">#151C34</Color>
    <Color x:Key="ButtonHoverColor">#1C2444</Color>
    <Color x:Key="SegmentColor">#11172C</Color>
    <Color x:Key="PillColor">#15FFFFFF</Color>

    <Color x:Key="TextPrimaryColor">#EEF1F8</Color>
    <Color x:Key="TextSecondaryColor">#7E879F</Color>
    <Color x:Key="TextTertiaryColor">#8A93AD</Color>
    <Color x:Key="TextMutedColor">#7C849C</Color>
    <Color x:Key="TextStrongColor">#D6DBEC</Color>
    <Color x:Key="TextControlColor">#C3CAE0</Color>
    <Color x:Key="GripColor">#3C4660</Color>
    <Color x:Key="SegmentActiveColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="BackdropBrush" Color="{StaticResource BackdropColor}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="TitlebarBrush" Color="{StaticResource TitlebarColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="{StaticResource SurfaceSelectedColor}" />
    <SolidColorBrush x:Key="ChipBrush" Color="{StaticResource ChipColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
    <SolidColorBrush x:Key="TrackRemainderBrush" Color="{StaticResource TrackRemainderColor}" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="{StaticResource SwitchOffColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="{StaticResource TextControlColor}" />
    <SolidColorBrush x:Key="SegmentBrush" Color="{StaticResource SegmentColor}" />
    <SolidColorBrush x:Key="PillBrush" Color="{StaticResource PillColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextStrongBrush" Color="{StaticResource TextStrongColor}" />
    <SolidColorBrush x:Key="TextControlBrush" Color="{StaticResource TextControlColor}" />
    <SolidColorBrush x:Key="GripBrush" Color="{StaticResource GripColor}" />
    <SolidColorBrush x:Key="SegmentActiveBrush" Color="{StaticResource SegmentActiveColor}" />
    <SolidColorBrush x:Key="BadgeSourceTextBrush" Color="#D3A6FA" />
    <SolidColorBrush x:Key="BadgeOverlapTextBrush" Color="#F5B866" />

    <!-- Hairlines: white at 5-8%, strong borders up to 16%. -->
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#B15CF0" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E23B4E" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#3DDC97" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F5A64B" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B15CF0" Offset="0" />
        <GradientStop Color="#4D9BFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentVerticalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B15CF0" Offset="0" />
        <GradientStop Color="#4D9BFF" Offset="1" />
    </LinearGradientBrush>
    <!-- Now-playing card, DESIGN.md §6: #171F40 -> #121831. -->
    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#171F40" Offset="0" />
        <GradientStop Color="#121831" Offset="0.62" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#14FFFFFF" />

    <!-- Window lift 0 10px 26px rgba(0,0,0,.5); card glow; icon glow. -->
    <DropShadowEffect x:Key="WindowShadow" Color="#000000" BlurRadius="26" ShadowDepth="10" Direction="270" Opacity="0.5" />
    <DropShadowEffect x:Key="CardShadow" Color="#4D9BFF" BlurRadius="30" ShadowDepth="0" Opacity="0.35" />
    <DropShadowEffect x:Key="IconShadow" Color="#B15CF0" BlurRadius="16" ShadowDepth="0" Opacity="0.65" />
</ResourceDictionary>
