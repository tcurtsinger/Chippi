<!-- Dark theme: DESIGN.md front matter, colors. Light.xaml defines every key here with its light
     value. Key names are older than the values (Surface is the card, Panel the flyout card), so call
     sites keep working. AccentBrush and OnAccentBrush are the Blue defaults; ThemeManager.SetAccent
     overrides them at the application level. Theme-invariant tokens live in Palette.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="BackdropBrush" Color="#202020" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="TitlebarBrush" Color="#202020" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="FlyoutBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="FlyoutFooterBrush" Color="#202020" />
    <SolidColorBrush x:Key="PanelBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#0DFFFFFF" />

    <!-- Controls -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChipBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SegmentTroughBrush" Color="#38000000" />
    <SolidColorBrush x:Key="SegmentStrokeBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SegmentActiveBgBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="SegmentActiveBrush" Color="#FFFFFF" />
    <x:Null x:Key="SegmentSelectedShadow" />
    <SolidColorBrush x:Key="InputBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="InputStrokeBottomBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="InputFocusBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="SwitchOffStrokeBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="SwitchOffKnobBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="CheckBoxOffBrush" Color="#1A000000" />
    <!-- Slider remainder and scrollbar thumb (Windows' strong control fill). -->
    <SolidColorBrush x:Key="TrackRemainderBrush" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#454545" />

    <!-- Strokes and dividers -->
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#14FFFFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextStrongBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="TextControlBrush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#ABABAB" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9D9D9D" />
    <SolidColorBrush x:Key="GripBrush" Color="#9D9D9D" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#FFFFFF" />

    <!-- Accent (Blue until ThemeManager.SetAccent runs) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#000000" />

    <!-- Signals -->
    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="WarningBorder45Brush" Color="#73FCE100" />
    <SolidColorBrush x:Key="BadgeOverlapTextBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="BadgeOverlapBackgroundBrush" Color="#1AFCE100" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />

    <!-- Flyout shadow: 0 8px 32px rgba(0,0,0,.28). -->
    <DropShadowEffect x:Key="WindowShadow" Color="#000000" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.28" />

    <!-- ===== Island (shell redesign, docs/shell-redesign/design/final.html): the Windows 11 widget look
         in both themes, with the pet's violet as its own accent (the Accent setting doesn't reach it).
         The surface is solid: with Transparency effects off, Windows draws acrylic solid too. ===== -->
    <SolidColorBrush x:Key="IslandBrush" Color="#F528282C" />
    <SolidColorBrush x:Key="IslandBorderBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="IslandTabBorderBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="IslandFooterBrush" Color="#09FFFFFF" />
    <SolidColorBrush x:Key="IslandHairBrush" Color="#14FFFFFF" />
    <!-- Cards inside the panel, and controls (buttons, tiles, segments) on it. -->
    <SolidColorBrush x:Key="IslandPanelBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="IslandCardBorderBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="IslandButtonBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="IslandButtonHoverBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="IslandPressedBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="IslandControlBorderBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="IslandHoverBrush" Color="#0FFFFFFF" />
    <!-- An empty bar or meter, the slider's remainder, its thumb ring, and a muted bar's fill. -->
    <SolidColorBrush x:Key="IslandTrackBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="IslandSliderTrackBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="IslandThumbBrush" Color="#454545" />
    <SolidColorBrush x:Key="IslandMutedFillBrush" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="IslandTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="IslandTextSecondaryBrush" Color="#C9C9C9" />
    <SolidColorBrush x:Key="IslandTextTertiaryBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="IslandCautionBrush" Color="#FF99A4" />
    <!-- Accent: a glyph, link or mark; the fill behind whatever is on, with on-accent text on it;
         and the tint behind a selected row. -->
    <SolidColorBrush x:Key="IslandAccentBrush" Color="#B79CFF" />
    <LinearGradientBrush x:Key="IslandAccentFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B78FFF" Offset="0" />
        <GradientStop Color="#82AEFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="IslandOnAccentBrush" Color="#170F2E" />
    <SolidColorBrush x:Key="IslandAccentTintBrush" Color="#24B79CFF" />
    <DropShadowEffect x:Key="IslandShadow" Color="#000000" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.45" />
    <DropShadowEffect x:Key="IslandExpandedShadow" Color="#000000" BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.5" />
    <DropShadowEffect x:Key="IslandPlayGlow" Color="#B78FFF" BlurRadius="16" ShadowDepth="6" Direction="270" Opacity="0.35" />
    <DropShadowEffect x:Key="IslandThumbShadow" Color="#000000" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.3" />
</ResourceDictionary>
