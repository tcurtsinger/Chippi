<!-- Theme-invariant tokens: identical in dark and light, so they are defined once here and never
     swapped by ThemeManager. DESIGN.md §2 (critical, island), §4 (island shadows), §7 (pet). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Critical fills behind white text. -->
    <SolidColorBrush x:Key="DangerDeepBrush" Color="#C42B1C" />

    <!-- Island: darker than any window and never themed. It always uses the dark accent shade, which
         ThemeManager.SetAccent writes at the application level (the island merges Dark.xaml locally,
         which would hide an AccentBrush). -->
    <SolidColorBrush x:Key="IslandBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="IslandBorderBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="IslandTabBorderBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="IslandTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="IslandTextTertiaryBrush" Color="#ABABAB" />
    <SolidColorBrush x:Key="IslandPanelBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="IslandAccentBrush" Color="#4CC2FF" />
    <DropShadowEffect x:Key="IslandShadow" Color="#000000" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.45" />
    <DropShadowEffect x:Key="IslandExpandedShadow" Color="#000000" BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.45" />

    <!-- Gumdrop, DESIGN.md §7. The Synth body is the app's one gradient. -->
    <LinearGradientBrush x:Key="PetSynthBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B15CF0" Offset="0" />
        <GradientStop Color="#4D9BFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PetIrisBrush" Color="#CBB2FF" />
    <SolidColorBrush x:Key="PetAzureBrush" Color="#8EC0FF" />
    <SolidColorBrush x:Key="PetSignalBrush" Color="#8EE6C0" />
    <SolidColorBrush x:Key="PetEmberBrush" Color="#FFC58F" />
    <SolidColorBrush x:Key="PetFrostBrush" Color="#E8ECF6" />
    <SolidColorBrush x:Key="PetInkBrush" Color="#0B0F1F" />
    <SolidColorBrush x:Key="PetEyeHighlightBrush" Color="#FFFFFF" />
    <!-- Shine: white at 38%. Blush: #FF8FB0 at 70%. Ground shadow: black at 35%. -->
    <SolidColorBrush x:Key="PetShineBrush" Color="#61FFFFFF" />
    <SolidColorBrush x:Key="PetBlushBrush" Color="#B3FF8FB0" />
    <SolidColorBrush x:Key="PetSparkBrush" Color="#F5C451" />
    <SolidColorBrush x:Key="PetShadowBrush" Color="#59000000" />
    <!-- The sleepy z's are Muted; the pet lives on the dark island, so it uses the dark value. -->
    <SolidColorBrush x:Key="PetZBrush" Color="#9D9D9D" />
</ResourceDictionary>
