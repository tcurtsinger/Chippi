<!-- Theme-invariant tokens: identical in dark and light, so they are defined once here and never
     swapped by ThemeManager. DESIGN.md §2 (critical), §7 (pet). The island's keys follow the theme,
     so they live in Dark.xaml and Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Critical fills behind white text. -->
    <SolidColorBrush x:Key="DangerDeepBrush" Color="#C42B1C" />

    <!-- Chippi, DESIGN.md §7. His body colors are ChippiPet.ColorOf's; his sparks follow the theme. -->
    <SolidColorBrush x:Key="PetInkBrush" Color="#0B0F1F" />
    <SolidColorBrush x:Key="PetEyeHighlightBrush" Color="#FFFFFF" />
    <!-- The rim of his body and eye whites: ink at 18%. The ground shadow: black at 26%, fading out from the middle. -->
    <SolidColorBrush x:Key="PetRimBrush" Color="#2E0B0F1F" />
    <RadialGradientBrush x:Key="PetShadowBrush">
        <GradientStop Color="#42000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>
</ResourceDictionary>
