<!-- Light theme: DESIGN.md front matter, colors-light. Mirrors every Dark.xaml key. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="BackdropBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="TitlebarBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FBFBFB" />
    <SolidColorBrush x:Key="FlyoutBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="FlyoutFooterBrush" Color="#EBEBEB" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#0F000000" />

    <!-- Controls -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#F6F6F6" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ChipBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#0E000000" />
    <SolidColorBrush x:Key="SegmentTroughBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="SegmentStrokeBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="SegmentActiveBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SegmentActiveBrush" Color="#1A1A1A" />
    <!-- 0 1px 2px rgba(0,0,0,.12), light only. -->
    <DropShadowEffect x:Key="SegmentSelectedShadow" Color="#000000" BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.12" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputStrokeBottomBrush" Color="#73000000" />
    <SolidColorBrush x:Key="InputFocusBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SwitchOffStrokeBrush" Color="#8C000000" />
    <SolidColorBrush x:Key="SwitchOffKnobBrush" Color="#99000000" />
    <SolidColorBrush x:Key="CheckBoxOffBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TrackRemainderBrush" Color="#72000000" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#FFFFFF" />

    <!-- Strokes and dividers -->
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="BorderBrush" Color="#12000000" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#29000000" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#1F000000" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextStrongBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#404040" />
    <SolidColorBrush x:Key="TextControlBrush" Color="#404040" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#5D5D5D" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#616161" />
    <SolidColorBrush x:Key="GripBrush" Color="#616161" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#1A1A1A" />

    <!-- Accent (Blue until ThemeManager.SetAccent runs) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <!-- Signals -->
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="WarningBorder45Brush" Color="#739D5D00" />
    <SolidColorBrush x:Key="BadgeOverlapTextBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="BadgeOverlapBackgroundBrush" Color="#1A9D5D00" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />

    <!-- Flyout shadow: 0 8px 32px rgba(0,0,0,.14). -->
    <DropShadowEffect x:Key="WindowShadow" Color="#000000" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.14" />
</ResourceDictionary>
