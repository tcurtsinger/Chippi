<!-- Light theme: mirrors every Dark.xaml key (DESIGN.md front matter, colors-light). Ported from
     Hopper's Ui/Themes/Light.xaml. The island and pet stay as in Palette.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackdropColor">#E9EDF4</Color>
    <Color x:Key="WindowBackgroundColor">#F7F8FC</Color>
    <Color x:Key="TitlebarColor">#EEF1F7</Color>
    <Color x:Key="PanelColor">#F1F4FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceSelectedColor">#EEF2FD</Color>
    <Color x:Key="ChipColor">#EEF1F7</Color>
    <Color x:Key="InputColor">#FFFFFF</Color>
    <Color x:Key="TrackColor">#E4E8F1</Color>
    <Color x:Key="TrackRemainderColor">#DDE2EE</Color>
    <Color x:Key="SwitchOffColor">#D3D9E6</Color>
    <Color x:Key="ButtonBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ButtonHoverColor">#F0F3FA</Color>
    <Color x:Key="SegmentColor">#EAEEF6</Color>
    <Color x:Key="PillColor">#08000000</Color>

    <Color x:Key="TextPrimaryColor">#1A2036</Color>
    <Color x:Key="TextSecondaryColor">#5C6580</Color>
    <Color x:Key="TextTertiaryColor">#79839B</Color>
    <Color x:Key="TextMutedColor">#6B7488</Color>
    <Color x:Key="TextStrongColor">#2A3147</Color>
    <Color x:Key="TextControlColor">#34405E</Color>
    <Color x:Key="GripColor">#B5BCCD</Color>
    <Color x:Key="SegmentActiveColor">#1A2036</Color>

    <SolidColorBrush x:Key="BackdropBrush" Color="{StaticResource BackdropColor}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="TitlebarBrush" Color="{StaticResource TitlebarColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="{StaticResource SurfaceSelectedColor}" />
    <SolidColorBrush x:Key="ChipBrush" Color="{StaticResource ChipColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
    <SolidColorBrush x:Key="TrackRemainderBrush" Color="{StaticResource TrackRemainderColor}" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="{StaticResource SwitchOffColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="{StaticResource TextControlColor}" />
    <SolidColorBrush x:Key="SegmentBrush" Color="{StaticResource SegmentColor}" />
    <SolidColorBrush x:Key="PillBrush" Color="{StaticResource PillColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextStrongBrush" Color="{StaticResource TextStrongColor}" />
    <SolidColorBrush x:Key="TextControlBrush" Color="{StaticResource TextControlColor}" />
    <SolidColorBrush x:Key="GripBrush" Color="{StaticResource GripColor}" />
    <SolidColorBrush x:Key="SegmentActiveBrush" Color="{StaticResource SegmentActiveColor}" />
    <!-- Light-only text colors approved 2026-10-21 (DESIGN.md §2): the dark values fail contrast here. -->
    <SolidColorBrush x:Key="BadgeSourceTextBrush" Color="#7B2DB8" />
    <SolidColorBrush x:Key="BadgeOverlapTextBrush" Color="#8A4B00" />

    <SolidColorBrush x:Key="BorderSoftBrush" Color="#12000000" />
    <SolidColorBrush x:Key="BorderBrush" Color="#17000000" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#2E000000" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="HoverBrush" Color="#10000000" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#8A3FD0" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E23B4E" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#3DDC97" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F5A64B" />
    <!-- Amber text (held and failed reasons, validation): Signal Amber stays for borders, dots and glyphs (DESIGN.md). -->
    <SolidColorBrush x:Key="WarningTextBrush" Color="#8A4B00" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B15CF0" Offset="0" />
        <GradientStop Color="#4D9BFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentVerticalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B15CF0" Offset="0" />
        <GradientStop Color="#4D9BFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F1F4FB" Offset="0.62" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#14000000" />

    <!-- Window lift in light: rgba(40,50,90,.22). -->
    <DropShadowEffect x:Key="WindowShadow" Color="#28325A" BlurRadius="26" ShadowDepth="10" Direction="270" Opacity="0.22" />
    <DropShadowEffect x:Key="CardShadow" Color="#4D9BFF" BlurRadius="30" ShadowDepth="0" Opacity="0.22" />
    <DropShadowEffect x:Key="IconShadow" Color="#B15CF0" BlurRadius="16" ShadowDepth="0" Opacity="0.55" />
</ResourceDictionary>
