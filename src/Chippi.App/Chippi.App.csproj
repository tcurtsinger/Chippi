<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Chippi</AssemblyName>
    <RootNamespace>Chippi.App</RootNamespace>
    <!-- Gumdrop's small form, generated by Tray/make_icon.py from DESIGN.md section 7. -->
    <ApplicationIcon>Tray\Assets\chippi.ico</ApplicationIcon>
    <!-- No PlatformTarget: the RID (win-x64 / win-arm64) decides the architecture. A build with no
         RID (F5, dotnet run) gets the machine's own, because CsWin32 cannot generate some APIs
         (Shell_NotifyIconGetRect) for AnyCPU. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <!-- Our own Main, so Velopack's hooks run before WPF starts (see Program.cs). -->
    <StartupObject>Chippi.App.Program</StartupObject>
  </PropertyGroup>

  <!-- The tray loads its frames from pack://application:,,,/Tray/Assets/chippi.ico. -->
  <ItemGroup>
    <Resource Include="Tray\Assets\chippi.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chippi.Clipboard\Chippi.Clipboard.csproj" />
    <ProjectReference Include="..\Chippi.Core\Chippi.Core.csproj" />
    <ProjectReference Include="..\Chippi.Input\Chippi.Input.csproj" />
    <ProjectReference Include="..\Chippi.UI\Chippi.UI.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.KeepAwake\Chippi.Features.KeepAwake.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.Downloads\Chippi.Features.Downloads.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.Sound\Chippi.Features.Sound.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.SystemMonitor\Chippi.Features.SystemMonitor.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.Scratchpad\Chippi.Features.Scratchpad.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.Clipboard\Chippi.Features.Clipboard.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.PlainPaste\Chippi.Features.PlainPaste.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.Shelf\Chippi.Features.Shelf.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.QuickActions\Chippi.Features.QuickActions.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.AgentUsage\Chippi.Features.AgentUsage.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.CleaningMode\Chippi.Features.CleaningMode.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.CloseProtection\Chippi.Features.CloseProtection.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.FocusFollowsMouse\Chippi.Features.FocusFollowsMouse.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.CommandBar\Chippi.Features.CommandBar.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.RadialMenu\Chippi.Features.RadialMenu.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.Debounce\Chippi.Features.Debounce.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.Shortcuts\Chippi.Features.Shortcuts.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.TextSnippets\Chippi.Features.TextSnippets.csproj" />
    <ProjectReference Include="..\Features\Chippi.Features.SmoothScrolling\Chippi.Features.SmoothScrolling.csproj" />
  </ItemGroup>

  <!-- P/Invoke via CsWin32. Each workstream lists its APIs in a NativeMethods.txt inside its own
       folder (Tray/, Island/, ...); every one of them is picked up, so no file is shared. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <AdditionalFiles Include="**\NativeMethods.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- VB-CABLE's pin ships with the app; build/pack.ps1 adds the checked zip next to it. -->
    <Content Include="..\..\build\vendor\vb-cable.json" Link="vendor\vb-cable\vb-cable.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Link imports use pinned native helpers. Build/test never invokes them; publish verifies and
       includes each runtime's tools and complete upstream licenses. No global installation. -->
  <Target Name="PublishSoundboardTools" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-arm64'">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\..\build\prepare-soundboard-tools.ps1&quot; -Runtime $(RuntimeIdentifier)" />
    <ItemGroup>
      <_SoundboardPublishFile Include="$(MSBuildProjectDirectory)\..\..\build\artifacts\soundboard\$(RuntimeIdentifier)\**\*" />
      <ResolvedFileToPublish Include="@(_SoundboardPublishFile)">
        <RelativePath>vendor\soundboard\%(_SoundboardPublishFile.RecursiveDir)%(_SoundboardPublishFile.Filename)%(_SoundboardPublishFile.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
