<!-- The tray flyout, DESIGN.md §5 "Tray flyout": 380 wide, up to 640 tall, flyout color, 1px
     stroke, 8px radius, flyout shadow. Header, tab strip, the open panel (12px padding, scrolls when
     tall) and a 48px footer. 13px at the root, so panels set flyout type by default.
     The window is transparent and larger than the card by ShadowMargin so the shadow can show. -->
<Window x:Class="Chippi.App.Flyout.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="urn:chippi-ui"
        xmlns:pet="clr-namespace:Chippi.App.Pet"
        xmlns:local="clr-namespace:Chippi.App.Flyout"
        Style="{StaticResource ChippiWindowStyle}"
        FontSize="13"
        Title="Chippi"
        AutomationProperties.Name="Chippi"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        KeyboardNavigation.TabNavigation="Cycle">
    <Grid x:Name="Frame" Margin="28,20,28,40">
        <!-- The shadow sits on its own layer so the card's text is not rendered through an effect. -->
        <Border CornerRadius="8" Background="{DynamicResource FlyoutBrush}" Effect="{DynamicResource WindowShadow}" />

        <Border x:Name="Card" Width="380" MaxHeight="640" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource WindowBorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: Gumdrop at 24 (idle) beside the name over the status line. -->
                <Grid Margin="12,12,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Decorative (AccessibilityView="Raw" in UWP terms): the status line carries the state. -->
                    <local:DecorativeHost VerticalAlignment="Center">
                        <pet:Gumdrop Size="24" Mood="Idle" />
                    </local:DecorativeHost>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Chippi" Style="{StaticResource HeadlineTextStyle}" />
                        <TextBlock x:Name="StatusLine" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Tabs: one per panel, left-aligned, with a hairline below. -->
                <Border x:Name="TabStrip" Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="12,0,12,0">
                    <c:SegmentedControl x:Name="Tabs"
                                        Style="{StaticResource FlyoutTabsStyle}"
                                        AutomationProperties.Name="Flyout sections"
                                        SelectionChanged="OnTabChanged" />
                </Border>

                <!-- The panel. The viewer reaches past the padding so focus rings at the edges are not clipped. -->
                <ScrollViewer x:Name="Scroller" Grid.Row="2" Focusable="False"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="Page" Margin="12" Focusable="False" IsTabStop="False" />
                </ScrollViewer>

                <!-- Footer: 48px of footer color under a hairline, subtle Settings and Quit. -->
                <Border Grid.Row="3" Height="48" Padding="8,0" CornerRadius="0,0,7,7" BorderThickness="0,1,0,0"
                        Background="{DynamicResource FlyoutFooterBrush}" BorderBrush="{DynamicResource BorderBrush}">
                    <DockPanel VerticalAlignment="Center">
                        <Button x:Name="FooterSettings" Style="{StaticResource SubtleButtonStyle}" Click="OnSettingsClick" AutomationProperties.Name="Settings">
                            <StackPanel Orientation="Horizontal">
                                <c:LucideIcon Data="{x:Static c:LucideIcons.Settings}" Size="16" VerticalAlignment="Center"
                                              Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Settings" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" Click="OnQuitClick" AutomationProperties.Name="Quit Chippi">
                            <StackPanel Orientation="Horizontal">
                                <c:LucideIcon Data="{x:Static c:LucideIcons.Power}" Size="16" VerticalAlignment="Center"
                                              Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Quit" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
