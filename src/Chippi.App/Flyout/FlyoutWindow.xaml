<!-- The tray flyout, DESIGN.md §5 "Tray flyout": 380 wide, up to 612 tall, Window color, 1px
     hairline, 16px radius, window lift, 14px padding, 12px between header, tabs, page and footer.
     The window is transparent and larger than the card by ShadowMargin so the lift can show. -->
<Window x:Class="Chippi.App.Flyout.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="urn:chippi-ui"
        xmlns:pet="clr-namespace:Chippi.App.Pet"
        xmlns:local="clr-namespace:Chippi.App.Flyout"
        Style="{StaticResource ChippiWindowStyle}"
        Title="Chippi"
        AutomationProperties.Name="Chippi"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        KeyboardNavigation.TabNavigation="Cycle">
    <Grid x:Name="Frame" Margin="28,20,28,40">
        <!-- The lift sits on its own layer so the card's text is not rendered through an effect. -->
        <Border CornerRadius="16" Background="{DynamicResource WindowBackgroundBrush}" Effect="{DynamicResource WindowShadow}" />

        <Border x:Name="Card" Width="380" MaxHeight="612" CornerRadius="16" Padding="14" BorderThickness="1"
                Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource WindowBorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: 34px chip square with Gumdrop at 28 (idle), wordmark over the status line, settings. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource ChipBrush}">
                        <!-- Decorative (AccessibilityView="Raw" in UWP terms): the status line carries the state. -->
                        <local:DecorativeHost HorizontalAlignment="Center" VerticalAlignment="Center">
                            <pet:Gumdrop Size="28" Mood="Idle" />
                        </local:DecorativeHost>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="Chippi" Style="{StaticResource HeadlineTextStyle}" />
                        <TextBlock x:Name="StatusLine" Style="{StaticResource CaptionTextStyle}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <c:IconButton x:Name="HeaderSettings" Grid.Column="2" Width="32" Height="30" VerticalAlignment="Center"
                                  Icon="{x:Static c:LucideIcons.Settings}" ToolTip="Settings"
                                  AutomationProperties.Name="Open settings" Click="OnSettingsClick" />
                </Grid>

                <!-- Tabs: the segmented trough, only the tabs something contributes to. -->
                <c:SegmentedControl x:Name="Tabs" Grid.Row="1" Margin="0,12,0,0"
                                    Style="{StaticResource FlyoutTabsStyle}"
                                    AutomationProperties.Name="Flyout sections"
                                    SelectionChanged="OnTabChanged" />

                <!-- The page. The viewer reaches 6px past the card's padding so focus rings (2px at
                     2px offset) on tiles at the edges are not clipped; the page is inset to match. -->
                <ScrollViewer x:Name="Scroller" Grid.Row="2" Margin="-6,6,-6,-6" Focusable="False"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="Page" Margin="6" Focusable="False" IsTabStop="False" />
                </ScrollViewer>

                <!-- Footer: Settings and Quit, both secondary. -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Click="OnSettingsClick" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <c:LucideIcon Data="{x:Static c:LucideIcons.Settings}" Size="15" VerticalAlignment="Center"
                                          Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Settings" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Click="OnQuitClick" AutomationProperties.Name="Quit Chippi">
                        <StackPanel Orientation="Horizontal">
                            <c:LucideIcon Data="{x:Static c:LucideIcons.Power}" Size="15" VerticalAlignment="Center"
                                          Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Quit" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
