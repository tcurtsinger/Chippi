<!-- Layout styles shared by the Settings pages. Controls come from Chippi.UI unchanged; these only
     place them (page header, setting rows, sidebar items). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PageTitleStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DisplayTextStyle}" />

    <Style x:Key="PageDescriptionStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A setting: Surface, 12px radius (the row radius), hairline. -->
    <Style x:Key="SettingRowStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="RowTitleStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TitleTextStyle}" />

    <Style x:Key="RowCaptionStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A section header: 24px above, 8px below. -->
    <Style x:Key="SectionEyebrowStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HeadlineTextStyle}">
        <Setter Property="Margin" Value="0,24,0,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Sidebar: 36px items, 16px icon, body label; the selected one is subtle-selected and Semibold. -->
    <Style x:Key="SidebarItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextControlBrush}" />

        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing8}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
