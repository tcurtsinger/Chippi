<!-- Settings window (DESIGN.md §5): 1120x720, custom 40px titlebar, 272px sidebar (a 48px rail below 1008 wide), page on the right. -->
<Window x:Class="Chippi.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="urn:chippi-ui"
        xmlns:pet="clr-namespace:Chippi.App.Pet"
        Title="Chippi Settings" Width="1120" Height="720" MinWidth="860" MinHeight="520"
        Style="{StaticResource ChippiWindowStyle}" WindowStyle="None" ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <!-- A 1px glass edge keeps the DWM frame, so Windows draws the shadow, rounds the corners and
             snap, Win+arrows and maximize all behave like a normal window. -->
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary Source="SettingsStyles.xaml" />
    </Window.Resources>

    <Border x:Name="Root" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Border Background="{DynamicResource TitlebarBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowButtonStyle}" Click="OnMinimize"
                                WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize" ToolTip="Minimize">
                            <c:LucideIcon Data="{x:Static c:LucideIcons.Minus}" Size="14"
                                          Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <!-- Windows hit-tests this one itself (snap layouts): see OnHook. -->
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowButtonStyle}" Click="OnMaximize"
                                WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximize" ToolTip="Maximize">
                            <c:LucideIcon x:Name="MaximizeGlyph" Data="{x:Static c:LucideIcons.Square}" Size="12"
                                          Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}" Click="OnClose"
                                WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close" ToolTip="Close">
                            <c:LucideIcon Data="{x:Static c:LucideIcons.Close}" Size="14"
                                          Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                        <!-- Decorative: the title beside it names the window. -->
                        <pet:Gumdrop Size="16" IsDecorative="True" IsHitTestVisible="False" />
                        <TextBlock Text="Chippi Settings" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="272" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Rail: below 1008 wide, the pages as icons; the menu button opens the sidebar over the page. -->
                <DockPanel x:Name="Rail" Margin="4,4,4,0" Visibility="Collapsed">
                    <Button DockPanel.Dock="Top" Style="{StaticResource RailButtonStyle}" Click="OnMenu"
                            AutomationProperties.Name="Menu" ToolTip="Menu">
                        <c:LucideIcon Data="{x:Static c:LucideIcons.Menu}" Size="16"
                                      Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button DockPanel.Dock="Top" Style="{StaticResource RailButtonStyle}" Click="OnRailSearch"
                            AutomationProperties.Name="Find a setting" ToolTip="Find a setting">
                        <c:LucideIcon Data="{x:Static c:LucideIcons.Search}" Size="16"
                                      Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Border DockPanel.Dock="Top" Height="1" Margin="8,2" Background="{DynamicResource BorderBrush}" />
                    <ListBox x:Name="RailNav" Style="{StaticResource NavListStyle}"
                             ItemContainerStyle="{StaticResource RailItemStyle}" ItemTemplate="{StaticResource RailItemTemplate}"
                             SelectionChanged="OnNavSelectionChanged" AutomationProperties.Name="Pages">
                        <ListBox.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource RailGroupHeaderTemplate}" />
                        </ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>

                <!-- Page: content at most 1000 wide (1080 with its margins), aligned left; its width follows the window (OnScrollerSizeChanged). -->
                <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" SizeChanged="OnScrollerSizeChanged">
                    <ContentControl x:Name="PageHost" Margin="40,4,40,28" MaxWidth="1000" HorizontalAlignment="Left" Focusable="False" />
                </ScrollViewer>

                <!-- Sidebar: one list, grouped. Over the page (with its menu button) while the rail's menu has it open. -->
                <Grid x:Name="Sidebar">
                    <!-- Its own layer, so the overlay's shadow doesn't soften the text. -->
                    <Border x:Name="SidebarBack" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource WindowBorderBrush}"
                            BorderThickness="0" />
                    <DockPanel x:Name="SidebarPanel" Margin="12,14,12,0">
                        <Button x:Name="OverlayMenuButton" DockPanel.Dock="Top" Style="{StaticResource RailButtonStyle}" Margin="-8,2,0,6"
                                Visibility="Collapsed" Click="OnMenu" AutomationProperties.Name="Menu" ToolTip="Menu">
                            <c:LucideIcon Data="{x:Static c:LucideIcons.Menu}" Size="16"
                                          Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <c:SearchBox x:Name="SettingsSearch" DockPanel.Dock="Top" Placeholder="Find a setting" Height="32" Margin="0,0,0,12"
                                     AutomationProperties.Name="Find a setting" TextChanged="OnSearchChanged" />
                        <ListBox x:Name="Nav" Style="{StaticResource NavListStyle}"
                                 ItemContainerStyle="{StaticResource NavItemStyle}" ItemTemplate="{StaticResource NavItemTemplate}"
                                 SelectionChanged="OnNavSelectionChanged" AutomationProperties.Name="Pages">
                            <ListBox.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource NavGroupHeaderTemplate}" />
                            </ListBox.GroupStyle>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
