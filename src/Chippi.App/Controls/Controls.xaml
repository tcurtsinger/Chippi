<!-- Templates for Chippi's own controls (DESIGN.md §6). Every interactive one has hover, the 2px
     keyboard focus ring at 2px offset (FocusRing* in Themes/SharedStyles.xaml) and disabled at .45.
     Merge after the theme, Palette.xaml and SharedStyles.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Chippi.App.Controls"
                    xmlns:m="clr-namespace:Chippi.Core.Modules;assembly=Chippi.Core">

    <c:BoolToVisibilityConverter x:Key="BoolToVis" />
    <c:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    <c:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
    <c:IconKeyToGeometryConverter x:Key="IconKeyToGeometry" />
    <c:PercentConverter x:Key="Percent" />

    <!-- ===== Eyebrow (Label role) ===== -->
    <Style TargetType="{x:Type c:Eyebrow}">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===== Icon button: 30px square, 7px radius, transparent until hover ===== -->
    <Style TargetType="{x:Type c:IconButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing7}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:IconButton}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7">
                        <c:LucideIcon Data="{TemplateBinding Icon}" Brush="{TemplateBinding Foreground}" Size="{TemplateBinding IconSize}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:IconToggleButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing7}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:IconToggleButton}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <c:LucideIcon x:Name="Normal" Data="{TemplateBinding Icon}" Brush="{TemplateBinding Foreground}" Size="{TemplateBinding IconSize}" />
                            <c:LucideIcon x:Name="Checked" Data="{TemplateBinding CheckedIcon}" Brush="{TemplateBinding Foreground}" Size="{TemplateBinding IconSize}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Normal" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Checked" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <!-- No checked icon: keep the normal one. Later triggers win. -->
                        <Trigger Property="CheckedIcon" Value="{x:Null}">
                            <Setter TargetName="Normal" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Checked" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Badge: 20px, 6px radius, 10.5/700 ===== -->
    <Style TargetType="{x:Type c:Badge}">
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:Badge}">
                    <Border x:Name="Chrome" Height="20" CornerRadius="6" BorderThickness="1" Padding="7,0"
                            Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Text}" FontSize="10.5" FontWeight="Bold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource ButtonTextBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Kind" Value="{x:Static m:BadgeKind.Source}">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BadgeSourceBackgroundBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BadgeSourceBorderBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource BadgeSourceTextBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="{x:Static m:BadgeKind.Overlap}">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BadgeOverlapBackgroundBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BadgeOverlapBorderBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource BadgeOverlapTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Status dot: 7px; green or amber glow when live, Ink Muted offline ===== -->
    <Style TargetType="{x:Type c:StatusDot}">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:StatusDot}">
                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}">
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="Glow" Color="#3DDC97" BlurRadius="8" ShadowDepth="0" Opacity="0.7" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Kind" Value="Attention">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarningBrush}" />
                            <Setter TargetName="Dot" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#F5A64B" BlurRadius="8" ShadowDepth="0" Opacity="0.7" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Kind" Value="Offline">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                            <Setter TargetName="Dot" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Search box: 36px, Input fill, hairline, 9px radius ===== -->
    <Style TargetType="{x:Type c:SearchBox}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource FocusRingBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:SearchBox}">
                    <Grid>
                        <Border x:Name="Chrome" CornerRadius="9" BorderThickness="1"
                                Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <c:LucideIcon Data="{x:Static c:LucideIcons.Search}" Size="15" Brush="{DynamicResource TextTertiaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Placeholder}"
                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="Collapsed" Margin="2,0,10,0" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center"
                                              Focusable="False" Margin="0,0,10,0"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <!-- Text fields show the ring whenever they hold keyboard focus, mouse or keyboard. -->
                        <Border x:Name="Ring" Margin="-4" BorderThickness="2" CornerRadius="13" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource FocusRingBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Segmented control =====
         Trough: Input, 11px radius, 4px padding and 4px gaps (2px trough padding + 2px item margin).
         Segment: transparent, Ink Tertiary; active gets the 22% gradient, 1px violet 55%, white text. -->
    <Style x:Key="SegmentItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Margin" Value="2" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing8}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SegmentActiveBgBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SegmentActiveBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SegmentActiveBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:SegmentedControl}">
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentItemStyle}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:SegmentedControl}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="2">
                        <ItemsPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flyout tabs: 46px, a 17px icon over an 11/700 label. Items are c:SegmentItem. -->
    <Style x:Key="TabSegmentItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource SegmentItemStyle}">
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="TabSegmentedControlStyle" TargetType="{x:Type c:SegmentedControl}" BasedOn="{StaticResource {x:Type c:SegmentedControl}}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource TabSegmentItemStyle}" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type c:SegmentItem}">
                    <StackPanel HorizontalAlignment="Center">
                        <c:LucideIcon Data="{Binding Icon}" Size="17" HorizontalAlignment="Center"
                                      Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== App volume row: 32 | 1fr | 40 | 30 grid, 18 and 14 rows, Surface, 12px radius, padding 9 8 9 10 ===== -->
    <Style TargetType="{x:Type c:AppVolumeRow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:AppVolumeRow}">
                    <Border x:Name="Chrome" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="10,9,8,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.RowSpan="2" Width="32" Height="32" CornerRadius="10" Background="{DynamicResource ChipBrush}">
                                <Grid>
                                    <TextBlock x:Name="Monogram" Text="{TemplateBinding Monogram}" FontSize="13" FontWeight="ExtraBold"
                                               Foreground="{DynamicResource TextControlBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    <Image x:Name="AppImage" Source="{TemplateBinding AppIcon}" Width="20" Height="20"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>

                            <TextBlock Grid.Column="1" Text="{TemplateBinding AppName}" Margin="10,0,6,0" VerticalAlignment="Center"
                                       FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{TemplateBinding DeviceName}" Margin="10,0,6,0" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource MonoTextStyle}" Foreground="{DynamicResource TextStrongBrush}"
                                       Text="{Binding Volume, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Percent}}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <c:IconToggleButton Grid.Column="3" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Icon="{x:Static c:LucideIcons.Volume}" CheckedIcon="{x:Static c:LucideIcons.VolumeMuted}"
                                                IsChecked="{Binding IsMuted, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                AutomationProperties.Name="{Binding AppName, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Mute {0}}" />

                            <Slider Grid.Row="2" Grid.ColumnSpan="4" Margin="0,8,2,0" Style="{StaticResource HopperSliderStyle}"
                                    Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                    Value="{Binding Volume, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                    AutomationProperties.Name="{Binding AppName, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0} volume}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AppIcon" Value="{x:Null}">
                            <Setter TargetName="Monogram" Property="Visibility" Value="Visible" />
                            <Setter TargetName="AppImage" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Stat tile: Surface, 12px radius; eyebrow, mono readout + mono caption, 2px azure sparkline 30px ===== -->
    <Style TargetType="{x:Type c:StatTile}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:StatTile}">
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="12,11,12,10">
                        <StackPanel>
                            <c:Eyebrow Text="{TemplateBinding Label}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{TemplateBinding Value}" Style="{StaticResource MonoReadoutTextStyle}" VerticalAlignment="Bottom" />
                                <TextBlock Text="{TemplateBinding Caption}" Style="{StaticResource MonoTextStyle}" Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Bottom" Margin="6,0,0,2" />
                            </StackPanel>
                            <Grid x:Name="PART_SparklineHost" Height="30" Margin="0,8,0,0">
                                <Polyline x:Name="PART_Sparkline" Stroke="{DynamicResource AzureBrush}" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Stash row: Surface, 12px radius; name over destination, mono age, undo ===== -->
    <Style TargetType="{x:Type c:StashRow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:StashRow}">
                    <Border x:Name="Chrome" Background="{DynamicResource SurfaceBrush}" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="12" Padding="12,8,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding FileName}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="Destination" Text="{TemplateBinding Destination}" Style="{StaticResource CaptionTextStyle}"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                <TextBlock x:Name="Reason" Text="{TemplateBinding HeldReason}" Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource WarningBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Age}" Style="{StaticResource MonoTextStyle}"
                                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="10,0,6,0" />
                            <c:IconButton x:Name="Undo" Grid.Column="2" Icon="{x:Static c:LucideIcons.Undo}" Command="{TemplateBinding UndoCommand}"
                                          AutomationProperties.Name="{Binding FileName, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Undo move of {0}}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHeld" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WarningBorder45Brush}" />
                            <Setter TargetName="Destination" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Reason" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Undo" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tool tile: 92px, 12px radius, 10px padding, 30px chip; on = violet 50% border, 16% wash, gradient chip ===== -->
    <Style TargetType="{x:Type c:ToolTile}">
        <Setter Property="Height" Value="92" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing12}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ToolTile}">
                    <Border x:Name="Chrome" CornerRadius="12" Padding="10" BorderThickness="1"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="Chip" Width="30" Height="30" CornerRadius="9" HorizontalAlignment="Left" Background="{DynamicResource ChipBrush}">
                                <c:LucideIcon x:Name="Glyph" Data="{TemplateBinding Icon}" Size="16" Brush="{DynamicResource TextControlBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Row="2" Text="{TemplateBinding Title}" Style="{StaticResource TitleTextStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="3" Text="{TemplateBinding StateLine}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentWashBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBorder50Brush}" />
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                            <Setter TargetName="Glyph" Property="Brush" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Feature card: min 128px, 14px radius, 13px padding ===== -->
    <Style TargetType="{x:Type c:FeatureCard}">
        <Setter Property="MinHeight" Value="128" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:FeatureCard}">
                    <Border x:Name="Chrome" CornerRadius="14" Padding="13" BorderThickness="1"
                            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSoftBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="Chip" Width="34" Height="34" CornerRadius="10" HorizontalAlignment="Left" Background="{DynamicResource ChipBrush}">
                                <c:LucideIcon x:Name="Glyph" Data="{TemplateBinding Icon}" Size="17" Brush="{DynamicResource TextControlBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ToggleButton x:Name="Switch" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          IsChecked="{Binding IsInstalled, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding FeatureName, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Install {0}}" />
                            <TextBlock Grid.Row="1" Text="{TemplateBinding FeatureName}" Style="{StaticResource TitleTextStyle}" Margin="0,11,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Text="{TemplateBinding Description}" FontSize="12" LineHeight="17" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            <WrapPanel Grid.Row="4" Margin="0,10,0,-6">
                                <c:Badge x:Name="ComingSoon" Kind="Needs" Text="Coming soon" Margin="0,0,6,6" Visibility="Collapsed" />
                                <ItemsControl ItemsSource="{TemplateBinding Badges}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type m:FeatureBadge}">
                                            <c:Badge Text="{Binding Text}" Kind="{Binding Kind}" Margin="0,0,6,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsInstalled" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBorder40Brush}" />
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                            <Setter TargetName="Glyph" Property="Brush" Value="White" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsInstalled" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBorder50Brush}" />
                        </MultiTrigger>
                        <Trigger Property="IsComingSoon" Value="True">
                            <Setter TargetName="Switch" Property="IsEnabled" Value="False" />
                            <Setter TargetName="ComingSoon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
