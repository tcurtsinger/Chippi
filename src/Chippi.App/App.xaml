<Application x:Class="Chippi.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Order matters: the theme (swapped by ThemeManager), invariant tokens, styles, controls. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Chippi.UI;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Chippi.UI;component/Themes/Palette.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Chippi.UI;component/Themes/SharedStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Chippi.UI;component/Controls/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
