<!-- The open island (DESIGN.md §5 Island): one Island-colored shape grown out of the tab, flat side on the
     same edge, 1px stroke on every side but the flat one, 20px corners away from the edge, the island
     shadow, 12px padding. It shows the tile grid or one tile's page and morphs between them; the orbit
     buttons sit around it. A transparent, topmost tool window that doesn't activate until the user clicks
     into it; while open it covers a fixed area around the tab, and its transparent pixels click through. -->
<Window x:Class="Chippi.App.Island.IslandPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chippi"
        Style="{StaticResource ChippiWindowStyle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="Manual" WindowStartupLocation="Manual"
        Left="-32000" Top="-32000" Width="408" Height="200">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Chippi.UI;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Chippi;component/Island/IslandStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Canvas x:Name="Root" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
        <!-- The shape; the shadow sits on its own layer, so the content above it renders without an effect. -->
        <Grid x:Name="Shape">
            <Border x:Name="ShapeShadow" Background="{StaticResource IslandBrush}" Effect="{StaticResource IslandExpandedShadow}" />
            <Border x:Name="ShapeFill" Background="{StaticResource IslandBrush}" BorderBrush="{StaticResource IslandBorderBrush}" />
        </Grid>
        <!-- The grid or a page, 520 × 360, placed where the shape is heading. -->
        <Border x:Name="Card" Padding="12" Opacity="0" TextElement.Foreground="{StaticResource IslandTextBrush}">
            <ContentControl x:Name="Page" Focusable="False" />
        </Border>
        <!-- The round buttons around the shape (IslandGeometry.OrbitLayout). -->
        <Canvas x:Name="Orbit" />
    </Canvas>
</Window>
