<!-- The widget (DESIGN.md §5): the 50px puck with Chippi, and the chip beside it toward the screen's middle
     (the song, or the highest activity). A borderless, transparent, topmost tool window that never activates,
     with room around the puck for its lift and shadow. Fully transparent pixels click through. -->
<Window x:Class="Chippi.App.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="urn:chippi-ui"
        xmlns:pet="clr-namespace:Chippi.App.Pet"
        Title="Chippi widget"
        Style="{StaticResource ChippiWindowStyle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="Manual" WindowStartupLocation="Manual"
        Left="-32000" Top="-32000" Width="340" Height="124">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Chippi;component/Island/IslandStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Canvas x:Name="Root" Width="340" Height="124">
        <!-- The chip: the song (cover, title · artist, the bars), or an activity's glyph and line. Canvas.Left or
             Canvas.Right is set in code, so it sits on the side toward the screen's middle. -->
        <Button x:Name="Chip" Canvas.Top="44" Style="{StaticResource IslandChipStyle}" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="Cover" Width="24" Height="24" CornerRadius="4" Background="{DynamicResource IslandButtonBrush}" Visibility="Collapsed">
                    <c:LucideIcon x:Name="CoverGlyph" Data="{x:Static c:LucideIcons.Music}" Size="14" Thickness="2" Brush="{DynamicResource IslandAccentBrush}" />
                </Border>
                <!-- The activity's glyph: its page's icon, the progress ring, or a dot. -->
                <Grid x:Name="Glyph" Width="15" Height="15" Margin="2,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <c:LucideIcon x:Name="GlyphIcon" Size="15" Thickness="2" Brush="{DynamicResource IslandAccentBrush}" />
                    <Grid x:Name="Ring" Width="14" Height="14">
                        <Ellipse Stroke="{DynamicResource IslandTrackBrush}" StrokeThickness="2" />
                        <Path x:Name="RingArc" Stroke="{DynamicResource IslandAccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource IslandAccentBrush}" />
                </Grid>
                <!-- The line: the song (title · artist, scrolling when it doesn't fit, IslandWindow.ShowSong) or the activity's. -->
                <Canvas x:Name="Song" Height="16" Margin="8,0,0,0" ClipToBounds="True" VerticalAlignment="Center"
                        TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource IslandTextBrush}">
                    <StackPanel x:Name="SongStrip" Orientation="Horizontal">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="SongMove" />
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="SongText" />
                        <TextBlock x:Name="SongCopy" Margin="40,0,0,0" />
                    </StackPanel>
                </Canvas>
                <StackPanel x:Name="Equalizer" Orientation="Horizontal" Height="14" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <Rectangle Style="{StaticResource IslandEqualizerBarStyle}" Height="8" />
                    <Rectangle Style="{StaticResource IslandEqualizerBarStyle}" Height="14" />
                    <Rectangle Style="{StaticResource IslandEqualizerBarStyle}" Height="10" />
                </StackPanel>
            </StackPanel>
        </Button>

        <!-- The puck. It grows on hover and lifts while dragged (both on the render transform, around its center). -->
        <Button x:Name="PuckButton" Canvas.Top="37" Width="50" Height="50" Style="{StaticResource IslandPuckButtonStyle}"
                AutomationProperties.Name="Chippi" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PuckScale" />
                    <RotateTransform x:Name="PuckTilt" />
                </TransformGroup>
            </Button.RenderTransform>
            <Grid>
                <Ellipse x:Name="PuckShadow" Fill="{DynamicResource IslandBrush}" Effect="{StaticResource IslandPuckShadow}" />
                <Ellipse Fill="{DynamicResource IslandBrush}" Stroke="{DynamicResource IslandBorderBrush}" StrokeThickness="1" />
                <!-- Decorative: the button's name and help text carry the state. -->
                <pet:ChippiPet x:Name="Pet" Size="36" Mood="Sleepy" IsDecorative="True" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                <!-- The muted mic: a red badge on the puck's lower right, ringed in the puck's color. -->
                <Grid x:Name="MicBadge" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-3"
                      IsHitTestVisible="False" Visibility="Collapsed">
                    <Ellipse Fill="{DynamicResource IslandBrush}" />
                    <Ellipse Width="18" Height="18" Fill="{StaticResource IslandBadgeBrush}" />
                    <c:LucideIcon Data="{x:Static c:LucideIcons.MicOff}" Size="11" Thickness="2" Brush="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Button>

        <Popup x:Name="Menu" AllowsTransparency="True" StaysOpen="False" Placement="Top" VerticalOffset="-8"
               PlacementTarget="{Binding ElementName=PuckButton}" PopupAnimation="None">
            <Border Background="{DynamicResource IslandBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="4" MinWidth="200">
                <StackPanel x:Name="MenuItems" TextElement.FontFamily="{StaticResource UiFont}" />
            </Border>
        </Popup>
    </Canvas>
</Window>
