<!-- The widget (DESIGN.md §5): one shape, the 50px puck with Chippi, or the 256 × 50 bar it stretches into toward the
     screen's middle while there is something to show (the song, or the highest activity), its puck end fixed.
     Status icons can extend a short side tab from the puck. A borderless, transparent, topmost tool window that never activates, with room
     around the puck for its lift and shadow. Fully transparent pixels click through. -->
<Window x:Class="Chippi.App.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="urn:chippi-ui"
        xmlns:pet="clr-namespace:Chippi.UI.Pet;assembly=Chippi.UI"
        xmlns:island="clr-namespace:Chippi.App.Island"
        Title="Chippi widget"
        Style="{StaticResource ChippiWindowStyle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="Manual" WindowStartupLocation="Manual"
        Left="-32000" Top="-32000" Width="536" Height="124">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Chippi;component/Island/IslandStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Canvas x:Name="Root" Width="536" Height="124">
        <!-- The widget: the puck, or the bar it unfolds into. Canvas.Left or Canvas.Right, the puck's outer side, is set
             in code, so the bar grows in either direction from the same local pet center. The grip is its transform origin. -->
        <Grid x:Name="PuckButton" Canvas.Top="37" Width="50" Height="50"
                AutomationProperties.Name="Chippi" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PuckScale" />
                    <RotateTransform x:Name="PuckTilt" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid>
                <island:PuckSurface x:Name="BodyShadow" IsHitTestVisible="False" CornerRadius="25" Background="{DynamicResource IslandBrush}" Effect="{DynamicResource IslandPuckShadow}" />
                <island:PuckSurface x:Name="Body" CornerRadius="25" Background="{DynamicResource IslandBrush}" BorderBrush="{DynamicResource IslandWidgetBorderBrush}" BorderThickness="1" />
                <!-- The bar's content, laid out on the full 256 from the puck's end and clipped while the bar unfolds:
                     the lead (cover or glyph) in the far round end, the two lines, then the bars or the pause mark by
                     Chippi. IslandWindow.LayOutBar mirrors the columns when Chippi is on the left. -->
                <Grid x:Name="BarLayer" ClipToBounds="True" IsHitTestVisible="False">
                    <Grid x:Name="Bar" Width="256" Height="50" Opacity="0" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <!-- The song's cover: a 34 circle, set 8 in, so it sits concentric with the bar's round end. -->
                        <Grid x:Name="Cover" Grid.Column="1" Width="34" Height="34" Visibility="Collapsed">
                            <Ellipse x:Name="CoverArt" Fill="{DynamicResource IslandButtonBrush}" />
                            <c:LucideIcon x:Name="CoverGlyph" Data="{x:Static c:LucideIcons.Music}" Size="16" Thickness="2" Brush="{DynamicResource IslandAccentBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Stroke="{DynamicResource IslandBorderBrush}" StrokeThickness="1" />
                        </Grid>
                        <!-- An activity's glyph in a tinted circle: its page's icon, the progress ring, a dot, or the agent's provider icon. -->
                        <Grid x:Name="Glyph" Grid.Column="1" Width="34" Height="34" Visibility="Collapsed">
                            <Ellipse x:Name="GlyphPlate" Fill="{DynamicResource IslandAccentTintBrush}" />
                            <c:LucideIcon x:Name="GlyphIcon" Size="16" Thickness="2" Brush="{DynamicResource IslandAccentBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Grid x:Name="Ring" Width="14" Height="14">
                                <Ellipse Stroke="{DynamicResource IslandTrackBrush}" StrokeThickness="2" />
                                <Path x:Name="RingArc" Stroke="{DynamicResource IslandAccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource IslandAccentBrush}" />
                            <Image x:Name="ProviderMark" Width="22" Height="22" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Collapsed" />
                        </Grid>
                        <!-- The title (scrolling when it doesn't fit, IslandWindow.ShowLine) over the artist or the feature. -->
                        <StackPanel x:Name="Lines" Grid.Column="3" VerticalAlignment="Center">
                            <Canvas x:Name="Song" Height="17" ClipToBounds="True" HorizontalAlignment="Left"
                                    TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="13" TextElement.FontWeight="SemiBold"
                                    TextElement.Foreground="{DynamicResource IslandTextBrush}">
                                <StackPanel x:Name="SongStrip" Orientation="Horizontal">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="SongMove" />
                                    </StackPanel.RenderTransform>
                                    <TextBlock x:Name="SongText" />
                                    <TextBlock x:Name="SongCopy" Margin="40,0,0,0" />
                                </StackPanel>
                            </Canvas>
                            <TextBlock x:Name="Detail" FontFamily="{StaticResource UiFont}" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{DynamicResource IslandTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- The track and pause mark share a lane. Other notices give this space back to the text. -->
                        <Grid x:Name="PlaybackMark" Grid.Column="4" Width="15" Margin="10,0,0,0" Visibility="Collapsed">
                            <StackPanel x:Name="Equalizer" Orientation="Horizontal" Height="14" VerticalAlignment="Center" Visibility="Collapsed">
                                <Rectangle Style="{StaticResource IslandEqualizerBarStyle}" Height="8" />
                                <Rectangle Style="{StaticResource IslandEqualizerBarStyle}" Height="14" />
                                <Rectangle Style="{StaticResource IslandEqualizerBarStyle}" Height="10" />
                            </StackPanel>
                            <c:LucideIcon x:Name="PausedMark" Data="{x:Static c:LucideIcons.Pause}" Size="14" Filled="True"
                                          Brush="{DynamicResource IslandTextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <!-- What the lead and the lines showed, fading out while something new arrives (Arrival). -->
                        <Image x:Name="LeadWas" />
                        <Image x:Name="LinesWas" />
                    </Grid>
                </Grid>
                <!-- Chippi keeps the full 50-DIP end. Status icons occupy their own inward-facing tab. -->
                <Grid x:Name="PuckEnd" Width="50" Height="50" HorizontalAlignment="Right">
                    <Grid x:Name="PetHolder" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PetScale" />
                        </Grid.RenderTransform>
                        <!-- Decorative: the button's name and help text carry the state. -->
                        <pet:ChippiPet x:Name="Pet" Size="{x:Static pet:PetSize.Puck}" Mood="Sleepy" IsDecorative="True" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
                <!-- The badges share the widget's surface, shadow and outer rim. -->
                <Canvas x:Name="BadgeLayer" IsHitTestVisible="False" ClipToBounds="True">
                    <Grid x:Name="AgentMark" Width="22" Height="22" Canvas.Top="14"
                          Visibility="Collapsed">
                        <Ellipse Fill="{DynamicResource IslandBrush}" />
                        <Ellipse x:Name="AgentMarkPlate" Width="18" Height="18" Fill="{DynamicResource IslandAccentFillBrush}" />
                        <!-- Fill the round badge with the app artwork; square icon corners are cropped. -->
                        <Border x:Name="AgentBadgeFace" Width="15" Height="15" CornerRadius="8" Background="{DynamicResource IslandOnAccentBrush}"
                                Visibility="Collapsed">
                            <Border.Clip>
                                <EllipseGeometry Center="7.5,7.5" RadiusX="7.5" RadiusY="7.5" />
                            </Border.Clip>
                            <Image x:Name="AgentBadgeProvider" Width="15" Height="15" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <c:LucideIcon x:Name="AgentMarkIcon" Data="{x:Static c:LucideIcons.Gauge}" Size="11" Thickness="2"
                                      Brush="{DynamicResource IslandOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="MicBadge" Width="22" Height="22" Canvas.Top="14"
                          Visibility="Collapsed">
                        <Ellipse Fill="{DynamicResource IslandBrush}" />
                        <Ellipse Width="18" Height="18" Fill="{StaticResource IslandBadgeBrush}" />
                        <c:LucideIcon Data="{x:Static c:LucideIcons.MicOff}" Size="11" Thickness="2" Brush="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <!-- Keep awake running while a song holds the bar: the accent says it's on and fine. -->
                    <Grid x:Name="AwakeBadge" Width="22" Height="22" Canvas.Top="14"
                          Visibility="Collapsed">
                        <Ellipse Fill="{DynamicResource IslandBrush}" />
                        <Ellipse Width="18" Height="18" Fill="{DynamicResource IslandAccentFillBrush}" />
                        <c:LucideIcon Data="{x:Static c:LucideIcons.Coffee}" Size="11" Thickness="2" Brush="{DynamicResource IslandOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Canvas>
                <!-- Separate Invoke targets; the parent handles mouse presses so both remain draggable. -->
                <Canvas x:Name="ClickTargets" Opacity="{Binding ElementName=Body, Path=Opacity}">
                    <Button x:Name="HomeButton" Height="50" Style="{StaticResource IslandWidgetTargetStyle}"
                            AutomationProperties.Name="Chippi" ToolTip="Open Chippi" />
                    <Button x:Name="ActivityButton" Height="50" Style="{StaticResource IslandWidgetTargetStyle}"
                            Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </Grid>

        <Popup x:Name="Menu" AllowsTransparency="True" StaysOpen="False" Placement="Top" VerticalOffset="-8"
               PlacementTarget="{Binding ElementName=PuckEnd}" PopupAnimation="None">
            <Border Background="{DynamicResource IslandBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="4" MinWidth="200">
                <StackPanel x:Name="MenuItems" TextElement.FontFamily="{StaticResource UiFont}" />
            </Border>
        </Popup>
    </Canvas>
</Window>
