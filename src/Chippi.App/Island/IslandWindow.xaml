<!-- The island's docked tab (DESIGN.md §5 Island): a borderless, transparent, topmost tool window that
     never activates, sized to the tab's live size on its edge. The half-oval is two paths built in code
     (the fill, and the stroke on every side but the flat one); the tab draws at its rest or live size
     inside the window, flat side on the edge. Fully transparent pixels click through. -->
<Window x:Class="Chippi.App.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="urn:chippi-ui"
        xmlns:pet="clr-namespace:Chippi.App.Pet"
        Title="Chippi island"
        Style="{StaticResource ChippiWindowStyle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="Manual" WindowStartupLocation="Manual"
        Left="-32000" Top="-32000" Width="84" Height="26">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The island stays dark in both themes (DESIGN.md §2): every themed key used inside it,
                     including those in Chippi.UI control templates, resolves to its dark value here. -->
                <ResourceDictionary Source="pack://application:,,,/Chippi.UI;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Chippi;component/Island/IslandStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root">
        <Button x:Name="Tab" Style="{StaticResource IslandTabStyle}" AutomationProperties.Name="Chippi">
            <Grid x:Name="TabBody">
                <Path x:Name="TabFill" Fill="{StaticResource IslandBrush}" />
                <Path x:Name="TabStroke" Stroke="{StaticResource IslandTabBorderBrush}" StrokeThickness="1" IsHitTestVisible="False" />
                <!-- Gumdrop, then the live glyph beside it (top) or under it (sides). Decorative: the
                     button's name and help text carry the state (DESIGN.md §7 Accessibility). -->
                <StackPanel x:Name="TabContent" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <pet:Gumdrop x:Name="Pet" Size="14" Mood="Sleepy" IsDecorative="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Grid x:Name="Glyph" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel x:Name="Equalizer" Orientation="Horizontal" HorizontalAlignment="Center" Height="12">
                            <Rectangle Style="{StaticResource IslandEqualizerBarStyle}" Height="7" />
                            <Rectangle Style="{StaticResource IslandEqualizerBarStyle}" Height="12" />
                            <Rectangle Style="{StaticResource IslandEqualizerBarStyle}" Height="9" />
                        </StackPanel>
                        <Grid x:Name="Ring">
                            <Ellipse Stroke="{StaticResource IslandTrackBrush}" StrokeThickness="2" />
                            <Path x:Name="RingArc" Stroke="{DynamicResource IslandAccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <c:LucideIcon x:Name="FolderGlyph" Data="{x:Static c:LucideIcons.Folder}" Size="12" Thickness="2" Brush="{DynamicResource IslandAccentBrush}" />
                        <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource IslandAccentBrush}" />
                        <Ellipse x:Name="CautionDot" Width="6" Height="6" Fill="{StaticResource WarningBrush}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Button>

        <Popup x:Name="DebugMenu" AllowsTransparency="True" StaysOpen="False" Placement="Bottom" VerticalOffset="8"
               PlacementTarget="{Binding ElementName=Tab}" PopupAnimation="None">
            <Border Background="{StaticResource IslandBrush}" BorderBrush="{StaticResource IslandBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="4" MinWidth="200">
                <StackPanel x:Name="DebugItems" TextElement.FontFamily="{StaticResource UiFont}" />
            </Border>
        </Popup>
    </Grid>
</Window>
