<!-- The island (DESIGN.md Â§5 Island): a borderless, transparent, topmost tool window that never
     activates. One surface morphs between the resting pill, the live pill and the expanded island;
     Gumdrop is a single resident that moves between the three slots. The window is only as big as
     the current state plus its lift, so transparent pixels around it are click-through. -->
<Window x:Class="Chippi.App.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="urn:chippi-ui"
        xmlns:pet="clr-namespace:Chippi.App.Pet"
        Title="Chippi island"
        Style="{StaticResource ChippiWindowStyle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False" SizeToContent="Manual" WindowStartupLocation="Manual"
        Left="-32000" Top="-32000" Width="180" Height="110">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The island stays dark in both themes (DESIGN.md Â§2): every themed key used inside it,
                     including those in Chippi.UI control templates, resolves to its dark value here. -->
                <ResourceDictionary Source="pack://application:,,,/Chippi.UI;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Chippi;component/Island/IslandStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
              Width="84" Height="34" SnapsToDevicePixels="True">
            <!-- Island lift, on a sibling so the effect is not re-rasterized when the content animates. -->
            <Border x:Name="Lift" Background="{StaticResource IslandBrush}" CornerRadius="17" Effect="{StaticResource IslandShadow}" />
            <Border x:Name="Frame" Background="{StaticResource IslandBrush}" BorderBrush="{StaticResource IslandBorderBrush}"
                    BorderThickness="1" CornerRadius="17">
                <Grid x:Name="Stage" ClipToBounds="True">

                    <!-- Live pill: 6px left (pet) and 14px right padding, title Â· source, equalizer. -->
                    <Grid x:Name="LiveLayer" Opacity="0" IsHitTestVisible="False" Margin="43,0,13,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LiveText" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{StaticResource IslandTextBrush}" />
                        <StackPanel x:Name="Equalizer" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Rectangle Style="{StaticResource IslandEqualizerBarStyle}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.45" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Style="{StaticResource IslandEqualizerBarStyle}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.8" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Style="{StaticResource IslandEqualizerBarStyle}"><Rectangle.RenderTransform><ScaleTransform ScaleY="1" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Style="{StaticResource IslandEqualizerBarStyle}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.62" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Style="{StaticResource IslandEqualizerBarStyle}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.35" /></Rectangle.RenderTransform></Rectangle>
                        </StackPanel>
                        <!-- Stash: a folder glyph in the equalizer's slot; held or failed swaps it for an amber dot. -->
                        <Grid x:Name="StashTail" Grid.Column="1" Width="15" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <c:LucideIcon x:Name="StashGlyph" Data="{x:Static c:LucideIcons.Folder}" Size="15" Brush="{StaticResource IslandTextTertiaryBrush}" />
                            <c:StatusDot x:Name="StashDot" Kind="Attention" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Grid>

                    <!-- Expanded: 328 wide, padding 12 / 14 / 14, 10px gaps (inside the 1px hairline). -->
                    <StackPanel x:Name="ExpandedLayer" Opacity="0" IsHitTestVisible="False" Width="300"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="13,11,13,13">

                        <!-- 1. Header: the pet's slot, "Chippi" 13/800, a mono clock. -->
                        <Grid Height="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Chippi" FontSize="13" FontWeight="ExtraBold" VerticalAlignment="Center"
                                       Foreground="{StaticResource IslandTextBrush}" />
                            <TextBlock x:Name="Clock" Grid.Column="2" Style="{StaticResource MonoTextStyle}" VerticalAlignment="Center"
                                       Foreground="{StaticResource IslandTextTertiaryBrush}" />
                        </Grid>

                        <TextBlock x:Name="EmptyText" Margin="0,10,0,0" Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource IslandTextTertiaryBrush}" Text="Nothing live right now" />

                        <!-- 2. Media: 46px art tile, title and source, 4px gradient progress. -->
                        <Grid x:Name="MediaSection" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="11" Background="{DynamicResource ChipBrush}">
                                <TextBlock x:Name="MediaMonogram" Style="{StaticResource HeadlineTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource IslandTextBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MediaTitle" Style="{StaticResource TitleTextStyle}" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource IslandTextBrush}" />
                                <TextBlock x:Name="MediaSource" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                           Foreground="{StaticResource IslandTextTertiaryBrush}" />
                                <Grid x:Name="MediaProgress" Height="4" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{StaticResource IslandTrackBrush}" />
                                    <Border CornerRadius="2" Background="{DynamicResource AccentGradientBrush}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- 3. Transport: previous and next at 32px around a 38px deep-gradient play/pause. -->
                        <StackPanel x:Name="TransportSection" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <c:IconButton x:Name="PreviousButton" Width="32" Height="32" Focusable="False" VerticalAlignment="Center"
                                          Icon="{x:Static c:LucideIcons.SkipBack}" AutomationProperties.Name="Previous track" />
                            <Button x:Name="PlayPauseButton" Style="{StaticResource IslandPlayButtonStyle}" Margin="14,0" AutomationProperties.Name="Pause">
                                <c:LucideIcon x:Name="PlayPauseIcon" Data="{x:Static c:LucideIcons.Pause}" Size="16" Brush="White" />
                            </Button>
                            <c:IconButton x:Name="NextButton" Width="32" Height="32" Focusable="False" VerticalAlignment="Center"
                                          Icon="{x:Static c:LucideIcons.SkipForward}" AutomationProperties.Name="Next track" />
                        </StackPanel>

                        <!-- 4. Two tiles: FOCUS TIMER in mono, JUST STASHED in title text. -->
                        <Grid x:Name="TileSection" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TimerTile" Style="{StaticResource IslandTileStyle}">
                                <StackPanel>
                                    <c:Eyebrow x:Name="TimerLabel" Foreground="{StaticResource IslandTextTertiaryBrush}" />
                                    <TextBlock x:Name="TimerValue" Style="{StaticResource MonoTextStyle}" FontSize="13.5" Margin="0,5,0,0"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource IslandTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="StashTile" Grid.Column="2" Style="{StaticResource IslandTileStyle}">
                                <StackPanel>
                                    <c:Eyebrow x:Name="StashLabel" Foreground="{StaticResource IslandTextTertiaryBrush}" />
                                    <TextBlock x:Name="StashValue" Style="{StaticResource TitleTextStyle}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource IslandTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 5. Agent usage: name, mono usage line, 5px gradient bar. -->
                        <Border x:Name="AgentSection" Style="{StaticResource IslandTileStyle}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="AgentName" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource IslandTextBrush}" />
                                <TextBlock x:Name="AgentUsage" Style="{StaticResource MonoTextStyle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextStrongBrush}" />
                                <Grid x:Name="AgentProgress" Height="5" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" CornerRadius="2.5" Background="{StaticResource IslandTrackBrush}" />
                                    <Border CornerRadius="2.5" Background="{DynamicResource AccentGradientBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Status rows (Keep awake and other background state). Not in DESIGN.md Â§5; see the WS3 report. -->
                        <StackPanel x:Name="StatusSection" />
                    </StackPanel>

                    <!-- The resident: one Gumdrop that moves between the resting, live and expanded slots.
                         Decorative here: the text beside it carries the state (DESIGN.md Â§7 Accessibility). -->
                    <Canvas>
                        <pet:Gumdrop x:Name="Pet" Size="28" Mood="Sleepy" Canvas.Left="27" Canvas.Top="2" IsDecorative="True" />
                    </Canvas>
                </Grid>
            </Border>

            <Popup x:Name="DebugMenu" AllowsTransparency="True" StaysOpen="False" Placement="Bottom" VerticalOffset="8"
                   PlacementTarget="{Binding ElementName=Island}" PopupAnimation="None">
                <Border Background="{StaticResource IslandPanelBrush}" BorderBrush="{StaticResource IslandBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="6" MinWidth="200">
                    <StackPanel x:Name="DebugItems" TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontWeight="Medium" />
                </Border>
            </Popup>
        </Grid>
    </Grid>
</Window>
