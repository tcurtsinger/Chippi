<!-- Island-only pieces (DESIGN.md §5 Island). The island stays dark in both themes, so these use the
     theme-invariant Island* and Palette keys only. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="urn:chippi-ui">

    <!-- Hover wash on the island: white at 9%, the dark theme's HoverBrush. -->
    <SolidColorBrush x:Key="IslandHoverBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="IslandTrackBrush" Color="#22294A" />

    <!-- The 38px deep-gradient play/pause with icon glow (DESIGN.md §5 Island, item 3). -->
    <Style x:Key="IslandPlayButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Ellipse x:Name="Fill" Fill="{StaticResource AccentGradientDeepBrush}" Effect="{DynamicResource IconShadow}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.76" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Debug menu (DebugMode only): a themed list, no stock menu chrome. -->
    <Style x:Key="IslandMenuItemStyle" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource IslandTextBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="30" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="8" Padding="10,0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource IslandHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Equalizer bar: gradient, 3px wide, scaled about its middle. -->
    <Style x:Key="IslandEqualizerBarStyle" TargetType="{x:Type Rectangle}">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="14" />
        <Setter Property="RadiusX" Value="1.5" />
        <Setter Property="RadiusY" Value="1.5" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Fill" Value="{DynamicResource AccentGradientBrush}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    </Style>

    <!-- Panel-colored island tile and row: 12px radius. -->
    <Style x:Key="IslandTileStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource IslandPanelBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,9,12,10" />
    </Style>
</ResourceDictionary>
