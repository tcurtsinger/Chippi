<!-- Island-only pieces (DESIGN.md §5 Island). The island stays dark in both themes, so these use the
     theme-invariant Island* and Palette keys only. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="urn:chippi-ui">

    <!-- Hover wash on the island: white at 9%, the dark theme's HoverBrush. -->
    <SolidColorBrush x:Key="IslandHoverBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="IslandTrackBrush" Color="#24FFFFFF" />

    <!-- The docked tab: only its content draws (the half-oval paths), so transparent pixels click through.
         A Button for Enter, Space and UI Automation's Invoke; the window handles the mouse itself. -->
    <Style x:Key="IslandTabStyle" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inner cards: white at 6%, 8px radius, 12px padding. -->
    <Style x:Key="IslandCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource IslandPanelBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Keyboard focus on the island, after the user clicked into it: a 2px white ring. -->
    <Style x:Key="IslandFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="11" BorderBrush="{StaticResource IslandTextBrush}" BorderThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Orbit buttons (DESIGN.md §5 Island): 40px circles in Island fill with a .14 stroke and a 16px glyph;
         hover #1F1F1F, pressed #000000; the active page's button (Tag "Active") gets a .5 white stroke. -->
    <DropShadowEffect x:Key="IslandOrbitShadow" Color="#000000" BlurRadius="20" ShadowDepth="8" Direction="270" Opacity="0.3" />
    <Style x:Key="IslandOrbitButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource IslandTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Ellipse Fill="{StaticResource IslandBrush}" Effect="{StaticResource IslandOrbitShadow}" />
                        <Ellipse x:Name="Fill" Fill="{StaticResource IslandBrush}" Stroke="{StaticResource IslandTabBorderBrush}" StrokeThickness="1" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Fill" Property="Stroke" Value="#80FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Fill" Value="#1F1F1F" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Fill" Value="#000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Grid tiles: 84px high, 8px radius, white at .06; hover .10, pressed .04. -->
    <Style x:Key="IslandTileStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="84" />
        <Setter Property="Foreground" Value="{StaticResource IslandTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" CornerRadius="8" Background="#0FFFFFFF">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#0AFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Now Playing's previous and next: 32px, glyph only, hover wash; dimmed when the app doesn't offer them. -->
    <Style x:Key="IslandTransportButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource IslandTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" CornerRadius="16" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource IslandHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.36" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row to pick on a page (an output, a mic): 44px, 6px radius, hover wash; the one in use is filled. -->
    <Style x:Key="IslandRowButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource IslandTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" MinHeight="44" Padding="10,0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource IslandPanelBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource IslandHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The docked island's footer buttons: a 16px glyph and a 13px label, hover wash. -->
    <Style x:Key="IslandFooterButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource IslandTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" CornerRadius="16" Background="Transparent" Padding="10,0,12,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource IslandHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#0AFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The 40px accent play/pause on Now Playing. -->
    <Style x:Key="IslandPlayLargeButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root">
                        <Ellipse x:Name="Fill" Fill="{DynamicResource IslandAccentBrush}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.76" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.36" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Debug menu (DebugMode only): a themed list, no stock menu chrome. -->
    <Style x:Key="IslandMenuItemStyle" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource IslandTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="10,0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource IslandHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The tab's 3-bar equalizer glyph: 12px tall, accent. -->
    <Style x:Key="IslandEqualizerBarStyle" TargetType="{x:Type Rectangle}">
        <Setter Property="Width" Value="2" />
        <Setter Property="RadiusX" Value="1" />
        <Setter Property="RadiusY" Value="1" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Fill" Value="{DynamicResource IslandAccentBrush}" />
    </Style>
</ResourceDictionary>
