<!-- Island-only pieces (DESIGN.md §5 Island). The island stays dark in both themes, so these use the
     theme-invariant Island* and Palette keys only. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="urn:chippi-ui">

    <!-- Hover wash on the island: white at 9%, the dark theme's HoverBrush. -->
    <SolidColorBrush x:Key="IslandHoverBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="IslandTrackBrush" Color="#24FFFFFF" />

    <!-- The docked tab: only its content draws (the half-oval paths), so transparent pixels click through.
         A Button for Enter, Space and UI Automation's Invoke; the window handles the mouse itself. -->
    <Style x:Key="IslandTabStyle" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inner cards: white at 6%, 8px radius, 12px padding. -->
    <Style x:Key="IslandCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource IslandPanelBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- The 32px accent play/pause (DESIGN.md §5 Island). -->
    <Style x:Key="IslandPlayButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Ellipse x:Name="Fill" Fill="{DynamicResource IslandAccentBrush}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.76" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Debug menu (DebugMode only): a themed list, no stock menu chrome. -->
    <Style x:Key="IslandMenuItemStyle" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource IslandTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="10,0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource IslandHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The tab's 3-bar equalizer glyph: 12px tall, accent. -->
    <Style x:Key="IslandEqualizerBarStyle" TargetType="{x:Type Rectangle}">
        <Setter Property="Width" Value="2" />
        <Setter Property="RadiusX" Value="1" />
        <Setter Property="RadiusY" Value="1" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Fill" Value="{DynamicResource IslandAccentBrush}" />
    </Style>
</ResourceDictionary>
