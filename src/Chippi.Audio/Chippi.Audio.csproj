<!-- The shared audio service for the Sound features: one engine thread, the device catalog,
     default-role ownership, sessions and endpoint controls. No WPF and no module code; every
     policy is tested against a fake IDeviceSystem, never real devices. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Chippi.Audio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NAudio.Wasapi" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chippi.Audio.Tests" />
  </ItemGroup>

  <!-- RNNoise, built in CI from native/rnnoise (hashes.csv). Both architectures ship; RnnoiseNative
       loads runtimes\win-<arch>\native\rnnoise.dll for the process architecture. A single-file publish
       would otherwise bundle both DLLs into Chippi.exe, where that path never finds them. -->
  <ItemGroup>
    <None Include="..\..\native\rnnoise\runtimes\**\rnnoise.dll" Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
  </ItemGroup>

</Project>
