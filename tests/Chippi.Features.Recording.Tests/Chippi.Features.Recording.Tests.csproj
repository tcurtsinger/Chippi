<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTestProject>true</IsTestProject><IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
    <!-- The overlay windows' tests: the app's themes and the shared WPF thread; the capture tests' hand-moved clock. -->
    <Compile Include="../Chippi.Island.Tests/WpfTestThread.cs" Link="WpfTestThread.cs" />
    <Compile Include="../Chippi.Capture.Tests/ManualTime.cs" Link="ManualTime.cs" />
    <ProjectReference Include="../../src/Features/Chippi.Features.Recording/Chippi.Features.Recording.csproj" />
  </ItemGroup>
</Project>
