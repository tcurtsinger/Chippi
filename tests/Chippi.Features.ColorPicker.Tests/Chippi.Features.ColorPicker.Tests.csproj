<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- UseWPF drops the implicit System.IO import. -->
    <Using Include="System.IO" />
    <!-- The page's tests: the app's themes and the shared WPF thread. -->
    <Compile Include="../Chippi.Island.Tests/WpfTestThread.cs" Link="WpfTestThread.cs" />
    <Compile Include="../Chippi.Capture.Tests/ManualTime.cs" Link="ManualTime.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Features\Chippi.Features.ColorPicker\Chippi.Features.ColorPicker.csproj" />
    <ProjectReference Include="..\..\src\Chippi.App\Chippi.App.csproj" />
  </ItemGroup>

</Project>
