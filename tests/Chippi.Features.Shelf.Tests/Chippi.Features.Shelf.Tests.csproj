    <Compile Include="../Chippi.Island.Tests/WpfTestThread.cs" Link="WpfTestThread.cs" />
    <Compile Include="../Chippi.Features.Clipboard.Tests/FakeHub.cs" Link="FakeHub.cs" />
    <ProjectReference Include="../../src/Features/Chippi.Features.Shelf/Chippi.Features.Shelf.csproj" />
  </ItemGroup>
