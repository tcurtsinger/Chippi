<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Runs the .editorconfig code-style rules (IDE0073 file header) during build. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>

    <!-- Builds are RID-specific (win-x64, win-arm64). Never pin PlatformTarget here. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <Version>0.1.0</Version>
    <Authors>Chippi contributors</Authors>
    <Product>Chippi</Product>
    <Copyright>Copyright (C) Chippi contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
</Project>
